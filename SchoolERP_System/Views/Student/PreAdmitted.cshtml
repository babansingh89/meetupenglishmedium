
@{
    ViewBag.Title = "Pre Admitted";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}


<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    /* ===== Base Card ===== */
    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    /* ===== Professional Table ===== */
    #tblMapping {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblMapping thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping thead th:last-child { border-right: none !important; }
    #tblMapping tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping tbody tr:nth-child(even) { background: #fafcfe; }
    #tblMapping tbody tr:hover { background: #eef6ff; }
    #tblMapping i.fa {
        color: #64748b;
        margin-right: 10px;
        transition: color .2s;
        cursor: pointer;
    }
    #tblMapping i.fa:hover { color: #0089b3; }
    #tblMapping i.IconeditclassFee { color: #16a34a !important; }
    #tblMapping i.Icondelclass { color: #dc2626 !important; }

    /* ===== DataTable controls ===== */
    #tblMapping_wrapper .dataTables_length label,
    #tblMapping_wrapper .dataTables_filter label,
    #tblMapping_wrapper .dataTables_info,
    #tblMapping_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblMapping_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblMapping_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblMapping_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }

    .m-b-10 {
        margin-bottom: 10px;
    }

    .m-t-10 {
        margin-top: 10px;
    }

    .modal-header {
        background: rgb(240, 188, 180);
    }

    i.fa {
        color: black;
        font-size: 16px;
        margin-right: 5px;
        cursor: pointer;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-person-plus-fill"></i></span>
                <span class="header-title">View Pre Admitted Student</span>
                <button class="btn btn-register openModal"><i class="bi bi-person-plus"></i> Registration</button>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <table class="table" id="tblMapping" style="width:100% !important; border-bottom:none;">
                    <thead>
                        <tr>
                            <th>Reg.No</th>
                            <th>Date</th>
                            <th>Student Name</th>
                            <th>DOB</th>
                            <th>Contact No.</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdId" value="0" />

@section body_scripts{


    <script type="text/javascript">
        $(document).ready(function () {
            fn_Bindtbl("0", "", "Select");

        });

        $(document).on("click", ".openModal", function () {
         var   url= '@Url.Action("StudentRegistration", "Student")'
            window.location.href = url;
        });

        $(document).on("click", ".IconeditclassFee", function () {
            var _Id = $(this).attr('data-ID');
            var medium_type =  $(this).attr('medium-type');
            $("#hdId").val(_Id);
            fn_Bindtbl(_Id, medium_type, "SelectByID");
        });

        $(document).on("click", ".Icondelclass", function () {
            if (confirm('Are you sure want to delete?')) {
                var _Id = $(this).attr('data-ID');
                fn_del(_Id);
            }
        });
        $(document).on("click", ".Iconeditclass", function () {
            var _Id = $(this).attr('data-ID');
            $("#hdId").val(_Id);
            fn_Bindtbl(_Id, "", "EditSelectByID");
        });

        function fn_Bindtbl(_Id, medium_type, Type) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewPreAdmitted", "Student")',
                data: JSON.stringify({ Id: _Id, Type: Type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {

                    if (Type == "Select") {
                        $('#tblMapping tbody').empty();
                        $.each(data, function (rowIndex, val) {
                            var row = '';
                            row += '<tr>';
                            row += '<td style="width:100px">' + val.SR_RegNo + '</td>';
                            row += '<td style="width:100px">' + val.SR_Date + '</td>';
                            row += '<td>' + val.SR_StudentName + '</td>';
                            row += '<td style="width:100px">' + val.SR_DOB + '</td>';
                            row += '<td style="width:100px">' + val.SR_PhNo + '</td>';
                            row += '<td style="width:65px">' + val.ClassName + '</td>';
                            row += '<td style="width:65px">' + val.SectionName + '</td>';
                            row += '<td style="width:65px; text-align:center;"><i class="fa fa-inr IconeditclassFee" style="color:green;" data-ID="' + val.SR_RegNo + '" medium-type="' + val.MediumType + '"></i><i class="fa fa-edit Iconeditclass" data-ID="' + val.SR_ID + '"></i><i class="fa fa-trash-o Icondelclass" style="color:red;" data-ID="' + val.SR_ID + '"></i></td>';
                            row += '</tr>';
                            $('#tblMapping tbody').append(row);

                        });
                        $('#tblMapping').dataTable();
                    }

                    if (Type == "SelectByID") {
                        var url = "";
                        if (medium_type == "1") {
                         url = '@Url.Action("StudentFeesCollection_Bengali", "Transaction", new { _Id = "__id__" })';

                        }
                        else {
                        url = '@Url.Action("StudentFeesCollection_Automapper", "Transaction", new { _Id = "__id__" })';
                        }
                        window.location.href = url.replace('__id__', _Id);
                    }
                    if (Type == "EditSelectByID") {
                        var url = '@Url.Action("StudentRegistration", "Student", new { _Id = "__id__" })';
                        window.location.href = url.replace('__id__', _Id);
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        }

        function fn_del(Id) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeletePreAdmitted", "Student")',
                data: JSON.stringify({ Id: Id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "deleteSuccessful") {
                        fn_Bindtbl("0", "", "Select");
                        FormSuccessError("Data deleted successfully.","Success", "errorBlock");
                        //alert("Class deleted successfully.");
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        };


    </script>
}












