
@{
    ViewBag.Title = "Enquiry";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}



<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    /* ===== Base Card ===== */
    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    /* ===== Professional Table ===== */
    #tblMapping {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblMapping thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping thead th:last-child { border-right: none !important; }
    #tblMapping tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping tbody tr:nth-child(even) { background: #fafcfe; }
    #tblMapping tbody tr:hover { background: #eef6ff; }
    #tblMapping i.fa {
        color: #64748b;
        margin-right: 10px;
        transition: color .2s;
        cursor: pointer;
    }
    #tblMapping i.fa:hover { color: #0089b3; }
    #tblMapping i.Icondelclass { color: #dc2626 !important; }
    #tblMapping i.IconAdmclass { color: #16a34a !important; }

    /* ===== DataTable controls ===== */
    #tblMapping_wrapper .dataTables_length label,
    #tblMapping_wrapper .dataTables_filter label,
    #tblMapping_wrapper .dataTables_info,
    #tblMapping_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblMapping_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblMapping_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblMapping_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }

    /* ===== Professional Enquiry Modal ===== */
    #Modal .modal-dialog { width: 850px; max-width: 95%; }
    #Modal .modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 25px 60px rgba(0,0,0,.15);
    }
    #Modal .modal-header {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 12px 12px 0 0;
        padding: 16px 24px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    #Modal .modal-title {
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: .2px;
    }
    #Modal .modal-header .close {
        color: rgba(255,255,255,.6);
        opacity: 1;
        text-shadow: none;
        font-size: 22px;
    }
    #Modal .modal-header .close:hover { color: #fff; opacity: 1; }
    #Modal .modal-body {
        padding: 24px;
        font-family: 'Roboto', sans-serif;
    }
    #Modal .form-group { margin-bottom: 14px; }
    #Modal .form-group label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    #Modal .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    #Modal .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #Modal .modal-footer {
        padding: 14px 24px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    #Modal .modal-footer .btn {
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        padding: 9px 20px;
        transition: all .2s;
    }
    #Modal .modal-footer .btn-primary {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        color: #fff;
    }
    #Modal .modal-footer .btn-primary:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
    }
    #Modal .modal-footer .btn-default {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        color: #64748b;
    }
    #Modal .modal-footer .btn-default:hover { background: #f8fafc; color: #1e293b; }
    #Modal .followup-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        margin-top: 8px;
    }
    #Modal .btn-add-followup {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 9px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
    }
    #Modal .btn-add-followup:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
    }
    #Modal #tbladd thead th {
        background: linear-gradient(135deg, #1e293b, #334155);
        color: #fff;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 10px 14px !important;
        border: none !important;
    }
    #Modal #tbladd tbody td {
        padding: 8px 14px !important;
        font-size: 12.5px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
    }
    #Modal #tbladd tbody tr:hover { background: #eef6ff; }

    .m-b-10 {
        margin-bottom: 10px;
    }

    .m-t-10 {
        margin-top: 10px;
    }

    .modal-header {
        background: rgb(240, 188, 180);
    }

    i.fa {
        color: black;
        font-size: 16px;
        margin-right: 5px;
        cursor: pointer;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-chat-left-text"></i></span>
                <span class="header-title">View Enquiry</span>
                <button class="btn btn-register openModal"><i class="bi bi-person-plus"></i> Add Enquiry</button>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <table class="table" id="tblMapping">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Date</th>
                            <th>Student Name</th>
                            <th>Phone</th>
                            <th>Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdId" value="0" />
<div class="modal fade" id="Modal" role="dialog" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="exampleModalLabel">Add/Update Enquiry</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @Html.Partial("~/Views/Shared/Modal_SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Type:<span style="color:red;">*</span></label>
                            <select id="ddlTypeList" class="form-control">
                                <option value="0">Select</option>
                                <option value="Phone">Phone</option>
                                <option value="Walking">Walking</option>
                                <option value="WebSite">WebSite</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date:<span style="color:red;">*</span></label>
                            <input type="text" class="form-control dateFormat" id="txtdate">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Student Name:<span style="color:red;">*</span></label>
                            <input type="text" class="form-control" id="txtStudentName">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Gender:<span style="color:red;">*</span></label>
                            <select id="ddlGenderList" class="form-control">
                                <option value="0">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>DOB:</label>
                            <input type="text" class="form-control dateFormat" id="txtDOB">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Father Name:</label>
                            <input type="text" class="form-control" id="txtFatherName">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Email:</label>
                            <input type="text" class="form-control" id="txtEmail">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Mobile:<span style="color:red;">*</span></label>
                            <input type="text" class="form-control Numeric" id="txtMobile" maxlength="10">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Class:<span style="color:red;">*</span></label>
                            @Html.DropDownList("ddlClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Next Follow Date:</label>
                            <input type="text" class="form-control dateFormat" id="txtNextFollowDate">
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Next Follow Up Note:</label>
                            <input type="text" class="form-control" id="txtNextFollowUpNote">
                        </div>
                    </div>
                </div>
                <div style=" background-color: #F9F2F2;" class="followup-panel">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Follow Up Date:</label>
                                <input type="text" class="form-control dateFormat" id="txtFollowUpDate">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Messege:</label>
                                <select id="ddlMessegeList" class="form-control">
                                    <option value="0">Select</option>
                                    <option value="WRONG NUMBER">WRONG NUMBER</option>
                                    <option value="WILL BE JOINING LATER">WILL BE JOINING LATER</option>
                                    <option value="NOT INTERESTED">NOT INTERESTED</option>
                                    <option value="NOW INTERESTED FOR NOW">NOW INTERESTED FOR NOW</option>
                                    <option value="JOINED COMPETETOR">JOINED COMPETETOR</option>
                                    <option value="CALL BACK LATER">CALL BACK LATER</option>
                                    <option value="FEES TOO HIGH">FEES TOO HIGH</option>
                                    <option value="COURSE TOO LENGTHY">COURSE TOO LENGTHY</option>
                                    <option value="NOT RESPONDING">NOT RESPONDING</option>
                                    <option value="NOT RESPONDING">OTHERS</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Follow Up Remarks:</label>
                                <input type="text" class="form-control" id="txtRemarks">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <button type="button" class="btn btn-add-followup" style="margin-top: 20px;" id="btnAdd"><i class="bi bi-plus-lg"></i> Add</button>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="panel-body">

                                <table class="table" id="tbladd">
                                    <thead>
                                        <tr>
                                            <th>Follow Up Date</th>
                                            <th>Messege</th>
                                            <th>Follow Up Remarks</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="btnSave">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section body_scripts{


    <script type="text/javascript">
        $(document).ready(function () {
            fn_Bindtbl("0", "Select");
            $("#ddlClassList").select2({
                placeholder: "Select"
            });
            $("#ddlMessegeList").select2({
                placeholder: "Select"
            });
            $("#ddlGenderList").select2({
                placeholder: "Select"
            });
            $("#ddlTypeList").select2({
                placeholder: "Select"
            });
        });

        $(document).on("click", ".openModal", function () {
            HideSuccErrDiv();
            ModalHideSuccErrDiv();
            fn_resetform();
            $("#Modal").modal();
        });

        $(document).on("click", ".Iconeditclass", function () {
            var _Id = $(this).attr('data-ID');
            $("#hdId").val(_Id);
            fn_Bindtbl(_Id, "SelectByID");
        });
        $(document).on("click", ".IconAdmclass", function () {
            var _EId = $(this).attr('data-ID');
            var url = '@Url.Action("StudentRegistration", "Student", new { _EId = "__EId__" })';
            window.location.href = url.replace('__EId__', _EId);
        });
        
        $(document).on("click", "#btnAdd", function () {

            var _txtFollowUpDate = $('#txtFollowUpDate').val();
            var _txtRemarks = $('#txtRemarks').val();
            var data = $('#ddlMessegeList').select2('data')[0]['text'];
            if (_txtFollowUpDate == '') {
                ModalPopupError("Please enter Follow Up Date.", "Error", "M_errorBlock");
                return false;
            }
            if (data == 'Select' || data == "0") {
                ModalPopupError("Please select Type.", "Error", "M_errorBlock");
                return false;
            }

            var markup = '<tr><td>' + _txtFollowUpDate + '</td><td>' + data + '</td><td>' + _txtRemarks + '</td><td><i class="fa fa-trash-o Icondelclassadd"></i></td></tr>';
            $("#tbladd >tbody").append(markup);

            fn_resetAdd();
        });
        $(document).on("click", ".Icondelclass", function () {
            if (confirm("Are you sure want to delete?")) {
                var _Id = $(this).attr('data-ID');
                fn_del(_Id);
            }
        });
        $(document).on("click", ".Icondelclassadd", function () {
            if (confirm("Are you sure want to delete?")) {
                $(this).closest('tr').remove();
            }
        });
        $(document).on("click", "#btnSave", function () {

            var _Id = $.trim($("#hdId").val());
            var _ddl1 = $('#ddlClassList').val();
            var _ddl2 = $('#ddlTypeList').val();
            var _ddl3 = $('#ddlGenderList').val();
            var _txtdate = $("#txtdate").val();
            var _txtStudentName = $("#txtStudentName").val();
            var _txtDOB = $("#txtDOB").val();
            var _txtFatherName = $("#txtFatherName").val();
            var _txtEmail = $("#txtEmail").val();
            var _txtMobile = $("#txtMobile").val();
            var _txtNextFollowDate = $("#txtNextFollowDate").val();
            var _txtNextFollowUpNote = $("#txtNextFollowUpNote").val();


            if (_ddl2 == '' || _ddl2 <= 0) {
                ModalPopupError("Please select Type.", "Error", "M_errorBlock");
                return false;
            }
            if (_txtdate == '') {
                ModalPopupError("Please enter Date.", "Error", "M_errorBlock");
                return false;
            }
            if (_txtStudentName == '') {
                ModalPopupError("Please enter Student Name.", "Error", "M_errorBlock");
                return false;
            }

            if (_ddl3 == '' || _ddl3 <= 0) {
                ModalPopupError("Please select Gender.", "Error", "M_errorBlock");
                return false;
            }
            if (_txtMobile == '') {
                ModalPopupError("Please enter Mobile Number.", "Error", "M_errorBlock");
                return false;
            }
            if (_ddl1 == '' || _ddl1 <= 0) {
                ModalPopupError("Please select Class.", "Error", "M_errorBlock");
                return false;
            }

            if ($('#tbladd >tbody >tr').length == 0) {
                ModalPopupError("Please add Follow up!", "Error", "M_errorBlock");
                return false;
            }
            var _Datadt = [];
            $('#tbladd > tbody > tr').each(function () {
                var v1 = $(this).find('td:eq(0)').text();
                var v2 = $(this).find('td:eq(1)').text();
                var v3 = $(this).find('td:eq(2)').text();
                _Datadt.push({
                    'FollowUpDate': v1, 'Messege': v2, 'Remarks': v3
                });
            });

            $.ajax({
                type: "POST",
                url: '@Url.Action("saveEnquiry", "Student")',
                data: JSON.stringify({
                    EnquiryID: _Id, E_Type: _ddl2, Gender: _ddl3, ClassID: _ddl1, E_Date: _txtdate, StudentName: _txtStudentName, DOB: _txtDOB, FatherName: _txtFatherName, Email: _txtEmail, Mobile: _txtMobile, NextFollowDate: _txtNextFollowDate, NextFollowUpNote: _txtNextFollowUpNote, Datadt: _Datadt
                }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "InsertSuccessful") {
                        fn_resetform();
                        fn_resetAdd();
                        ModalPopupError("Data Inserted successfully.", "Success", "M_errorBlock");
                        fn_Bindtbl("0", "Select");
                    }
                    else if (response == "UpdateSuccessful") {
                        fn_resetform();
                        fn_resetAdd();
                        ModalPopupError("Data updated successfully.", "Success", "M_errorBlock");
                        fn_Bindtbl("0", "Select");
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        });


        function fn_Bindtbl(_Id, Type) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("viewEnquiry", "Student")',
                data: JSON.stringify({ Id: _Id, Type: Type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (Type == "Select") {
                        $('#tblMapping tbody').empty();
                        $.each(data, function (rowIndex, val) {
                            var row = '';
                            row += '<tr>';
                            row += '<td>' + val.ClassName + '</td>';
                            row += '<td>' + val.E_Date + '</td>';
                            row += '<td>' + val.StudentName + '</td>';
                            row += '<td>' + val.Mobile + '</td>';
                            row += '<td>' + val.E_Type + '</td>';
                            row += '<td><i class="fa fa-edit Iconeditclass" data-ID="' + val.EnquiryID + '"></i><i class="fa fa-trash-o Icondelclass" data-ID="' + val.EnquiryID + '"></i><i class="fa fa-user-plus IconAdmclass" data-ID="' + val.EnquiryID + '"></i></td>';
                            row += '</tr>';
                            $('#tblMapping tbody').append(row);

                        });
                        $('#tblMapping').dataTable();
                    }

                    if (Type == "SelectByID") {
                        $('#btnSave').text("Update");
                        $('#txtFeeHead').val(data[0].FeeHeadName);
                        $('#txtFeeInstallment').val(data[0].Total_of_Installment);

                        $('#ddlClassList').select2("val", data[0].ClassID);
                        $('#ddlTypeList').select2("val", data[0].E_Type);
                        $('#ddlGenderList').select2("val", data[0].Gender);
                        $("#txtdate").val(data[0].E_Date);
                        $("#txtStudentName").val(data[0].StudentName);
                        $("#txtDOB").val(data[0].DOB);
                        $("#txtFatherName").val(data[0].FatherName);
                        $("#txtEmail").val(data[0].Email);
                        $("#txtMobile").val(data[0].Mobile);
                        $("#txtNextFollowDate").val(data[0].NextFollowDate);
                        $("#txtNextFollowUpNote").val(data[0].NextFollowUpNote);
                        for (var i = 0; i < data.length; i++) {
                            var markup = '<tr><td>' + data[i].FollowUpDate + '</td><td>' + data[i].Messege + '</td><td>' + data[i].Remarks + '</td><td><i class="fa fa-trash-o Icondelclass"></i></td></tr>';
                            $("#tbladd >tbody").append(markup);
                        }
                        $("#Modal").modal();
                        HideSuccErrDiv();
                        ModalHideSuccErrDiv();
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        }

        function fn_del(Id) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("deleteEnquiry", "Student")',
                data: JSON.stringify({ Id: Id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "deleteSuccessful") {
                        fn_Bindtbl("0", "Select");
                        FormSuccessError("Data deleted successfully.", "Success", "errorBlock");
                        //alert("Class deleted successfully.");
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        };
        function fn_resetAdd() {
            $("#txtFollowUpDate").val('');
            $("#txtRemarks").val('');
