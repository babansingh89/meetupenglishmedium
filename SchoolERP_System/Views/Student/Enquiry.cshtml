            $('#ddlTypeList').select2("val", '');
            $('#ddlGenderList').select2("val", '');
            $("#txtdate").val('');
            $("#txtStudentName").val('');
            $("#txtDOB").val('');
            $("#txtFatherName").val('');
            $("#txtEmail").val('');
            $("#txtMobile").val('');
            $("#txtNextFollowDate").val('');
            $("#txtNextFollowUpNote").val('');
            $('#tbladd tbody').empty();
            $('#btnSave').text("Save");
        }
    </script>
