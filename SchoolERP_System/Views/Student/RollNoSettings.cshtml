@{
    ViewBag.Title = "RollNoSettings";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    /* ===== Base Card ===== */
    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-body-modern {
        padding: 20px 24px 24px;
        font-family: 'Roboto', sans-serif;
    }

    /* ===== Professional Form ===== */
    .card-body-modern .form-group { margin-bottom: 14px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }

    /* ===== Professional Table ===== */
    #tblMapping {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblMapping thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping thead th:last-child { border-right: none !important; }
    #tblMapping tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping tbody tr:nth-child(even) { background: #fafcfe; }
    #tblMapping tbody tr:hover { background: #eef6ff; }
    #tblMapping tbody td .form-control {
        width: 100px;
        height: 34px;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #0f172a;
        padding: 6px 10px;
        text-align: center;
        box-shadow: none;
    }
    #tblMapping tbody td .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
        outline: none;
    }

    /* ===== Professional Buttons ===== */
    .card-body-modern .btn-save {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 28px;
        margin-left: 10px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-body-modern .btn-save:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern .btn-cancel {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        padding: 10px 24px;
        transition: all .2s;
    }
    .card-body-modern .btn-cancel:hover {
        background: #f8fafc;
        color: #1e293b;
        border-color: #cbd5e0;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-123"></i></span>
                <span class="header-title">Roll No Settings</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Class Name:<span style="color:red;">*</span></label>
                            @Html.DropDownList("ddlClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Section:<span style="color:red;">*</span></label>
                            <select id="ddlSectionList" class="form-control"> </select>
                        </div>
                    </div>
                </div>

                <div id="stlist" class="row">
                    <div class="col-lg-12">
                        <table class="table" id="tblMapping">
                            <thead>
                                <tr>
                                    <th>Reg.No</th>
                                    <th>Student Name</th>
                                    <th>Roll No</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group text-right">
                            <button type="button" class="btn btn-cancel" data-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-save" id="btnSave">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section body_scripts{


    <script type="text/javascript">
        $(document).ready(function () {

            $("#ddlClassList").select2({
                placeholder: "Select"
            });

            $("#ddlSectionList").select2({
                placeholder: "Select"
            });
        });



        $(document).on("click", "#btnSave", function () {
            ModalHideSuccErrDiv();
            var _Id = $.trim($("#hdnId").val());
            var _ddl1 = $('#ddlClassList').val();
            var _ddl2 = $('#ddlSectionList').val();

            if (_ddl1 == '' || _ddl1 <= 0) {
                FormSuccessError1("Please select Class.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            if (_ddl2 == '' || _ddl2 <= 0) {;
                FormSuccessError1("Please select Section.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            var Datadt = []; var ErrCnt = 0;
            $('#tblMapping > tbody > tr').each(function () {

                var v5 = $(this).find('td:eq(2)').find(":text").val();

                if (v5 != '' || v5 > 0) {

                    if (v5.length < 4) {
                        $(this).find('td:eq(2)').find(":text").css('background-color', '#fcd2ca');
                        ErrCnt++;
                    }
                    else {
                        $(this).find('td:eq(2)').find(":text").css('background-color', '');
                    }

                    Datadt.push({
                        'SR_ID': this.id, 'SR_CurrentRollNo': v5
                    });
                }
            });
           
            if (ErrCnt > 0)
                return false;

            if (Datadt.length == 0)
            {
                FormSuccessError1("Please Enter Roll Number.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("saveStudentRollNo", "Student")',
                data: JSON.stringify({ Datadt }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                   if (response == "UpdateSuccessful") {
                       fn_resetform();
                       FormSuccessError1("Data updated successfully.", "Success", "errorBlock", "div_Scroll");
                    
                    }
                    else {
                        alert("Error. " + response);
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        });

        $("#ddlSectionList").change(function () {
            var ID = $('option:selected', this).val();
            var _ddl1 = $('#ddlClassList').val();
            if (ID == '' || ID <= 0) {
                return false;
            }
            if (_ddl1 == '' || _ddl1 <= 0) {
                return false;
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("viewRollNoSettings", "Student")',
                data: JSON.stringify({ ClassID: _ddl1, SectionID: ID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#tblMapping tbody').empty();
                    $.each(data, function (rowIndex, val) {
                        var row = '';
                        row += '<tr id=' + val.SR_ID + '>';
                        row += '<td>' + val.SR_RegNo + '</td>';
                        row += '<td>' + val.SR_StudentName + '</td>';
                        row += '<td><input type="text" class="form-control Numeric" maxlength="4"  id="txtrn' + rowIndex + '" value="' + val.SR_CurrentRollNo + '"></td>';
                        row += '</tr>';
                        $('#tblMapping tbody').append(row);
                    });
                    if ($.fn.dataTable.isDataTable('#tblMapping')) {
                        table = $('#tblMapping').DataTable();
                    }
                    else {
                        table = $('#tblMapping').DataTable({
                            paging: false
                        });
                    }

                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });

        });
        $("#ddlClassList").change(function () {

            var ID = $('option:selected', this).val();
            if (ID == '' || ID <= 0) {
                return false;
            }
            $.ajax({
                type: "POST",
                url: '/Student/BindStream',
                data: JSON.stringify({ ID: ID, Type: "Se" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $("#ddlSectionList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlSectionList").append($("<option/>").val(this.SectionID).text(this.SectionName));
                        });
                    }
                }
            });
        });
        function fn_resetform() {
            $("#hdnId").val('0');
            $('#ddlClassList').select2("val", '');
            $('#ddlSectionList').select2("val", '');
            $('#tblMapping tbody').empty();
            $('#btnSave').text("Save");
        }
    </script>
}
