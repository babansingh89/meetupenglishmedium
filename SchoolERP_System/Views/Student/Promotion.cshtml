@{
    ViewBag.Title = "Promotion";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-body-modern {
        padding: 20px 24px 24px;
        font-family: 'Roboto', sans-serif;
    }

    .card-body-modern .form-group { margin-bottom: 14px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }

    #tblMapping thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 12px 18px !important;
        border: none !important;
        white-space: nowrap;
    }
    #tblMapping tbody td {
        padding: 10px 18px !important;
        color: #334155;
        font-size: 13px;
        border-bottom: 1px solid #e2e8f0 !important;
    }
    #tblMapping tbody tr:nth-child(even) td { background: #fafcfe; }
    #tblMapping tbody tr:hover td { background: #eef6ff; }

    .card-body-modern .btn-save {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 9px 26px;
        margin-left: 10px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-body-modern .btn-save:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern .btn-cancel {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        color: #475569;
        font-size: 14px;
        font-weight: 600;
        padding: 9px 26px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
    }
    .card-body-modern .btn-cancel:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #0f172a;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-arrow-up-circle"></i></span>
                <span class="header-title">Promote Students</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">From Session:<span style="color:red;">*</span></label>
                            @Html.DropDownList("ddlFromSessionList", (IList<SelectListItem>)ViewBag.SessionList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">To Session:<span style="color:red;">*</span></label>
                            @Html.DropDownList("ddlToSessionList", (IList<SelectListItem>)ViewBag.SessionList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">From Class Name:<span style="color:red;">*</span></label>
                            @Html.DropDownList("ddlFromClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">To Class Name:<span style="color:red;">*</span></label>
                            @Html.DropDownList("ddlToClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblMapping">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="chkAll" /></th>
                            <th>Reg No.</th>
                            <th>Student Name</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>PH No.</th>
                            <th>Roll No</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div class="row">
                    <div class="col-md-12 text-right">
                        <button class="btn btn-cancel" id="btn-clear"><i class="bi bi-x-circle"></i> Cancel</button>
                        <button class="btn btn-save" id="btnSave"><i class="bi bi-check-circle"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section body_scripts{
    <script type="text/javascript">
        var ErrorDiv = $("#errorBlock").find(".alert.alert-danger.display-none");
        var SuccessDiv = $("#errorBlock").find(".alert.alert-success.display-none");
        function hideAlert() {
            SuccessDiv.hide();
            ErrorDiv.hide();
        }
        $(document).ready(function () {

            $("#ddlFromClassList").select2({
                placeholder: "Select"
            });
            $("#ddlToClassList").select2({
                placeholder: "Select"
            });
            $("#ddlFromSessionList").select2({
                placeholder: "Select"
            });
            $("#ddlToSessionList").select2({
                placeholder: "Select"
            });
        });

        $('#tblMapping').find('tbody tr input:checkbox').click(function () {
            alert($(".chkRow").length);
            alert($(".chkRow:checked").length);
            if ($(".chkRow").length == $(".chkRow:checked").length) {
                $("#chkAll").prop("checked", true);
            } else {
                $("#chkAll").prop("checked", false);
            }
        });
        $("#chkAll").click(function () {
            var checkAll = $("#chkAll").prop('checked');
            if (checkAll) {
                $(".chkRow").prop("checked", true);
            } else {
                $(".chkRow").prop("checked", false);
            }
        });

        $("#ddlFromClassList").change(function () {
            hideAlert();
            var _ddl3 = $('#ddlFromSessionList').val();
            if (_ddl3 == '' || _ddl3 == '-1') {
                FormSuccessError1("Please select From Session.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            var ID = $('option:selected', this).val();
            $.ajax({
                type: "POST",
                url: '/Student/viewPromotion',
                data: JSON.stringify({ ClassID: ID, SessionID: _ddl3, }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {

                    $('#tblMapping tbody').empty();
                    $.each(data, function (rowIndex, val) {

                        var markup = '<tr id=' + val.SR_ID + '><td><input type="checkbox" class="chkRow" /></td><td>' + val.SR_RegNo + '</td><td>' + val.SR_StudentName + '</td><td>' + val.ClassName + '</td><td>' + val.SectionName + '</td><td>' + val.SR_PhNo + '</td><td>' + val.SR_CurrentRollNo + '</td></tr>';

                        $("#tblMapping >tbody").append(markup);
                    });

                    if ($.fn.dataTable.isDataTable('#tblMapping')) {
                        table = $('#tblMapping').DataTable();
                    }
                    else {
                        table = $('#tblMapping').DataTable({
                            paging: false
                        });
                    }
                    //$('#tblMapping').dataTable({ paging: false });
                }

            });
        });
        function fn_resetform() {

            $('#ddlFromClassList').select2("val", '');
            $('#ddlToClassList').select2("val", '');
            $('#ddlFromSessionList').select2("val", '');
            $('#ddlToSessionList').select2("val", '');
            $('#tblMapping tbody').empty();

        }

        $(document).on("click", "#btnSave", function () {
            var _ddl1 = $('#ddlFromClassList').val();
            var _ddl2 = $('#ddlToClassList').val();
            var _ddl3 = $('#ddlFromSessionList').val();
            var _ddl4 = $('#ddlToSessionList').val();

            var rowCount1 = $('#tblMapping >tbody >tr').length;

            if (_ddl1 == '' || _ddl1 == '-1') {
                FormSuccessError1("Please select From Class.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            if (_ddl2 == '' || _ddl2 == '-1') {
                FormSuccessError1("Please select To Class.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            if (_ddl3 == '' || _ddl3 == '-1') {
                FormSuccessError1("Please select From Session.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            if (_ddl4 == '' || _ddl4 == '-1') {
                FormSuccessError1("Please select To Session.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            var StdData = [];

            $('#tblMapping > tbody > tr').each(function () {

                var tr_id = $(this).attr('id');
                var number = $(this).find('td:eq(3)').text();
                if ($(this).find('td input[type=checkbox]').prop('checked') == true)
                    StdData.push({ 'StudentID': tr_id, 'Mobile': number });
            });

            if (StdData.length == 0) {
                FormSuccessError1("Please select Student.", "Error", "errorBlock", "div_Scroll");
                return false;
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("savePromotionMaster", "Student")',
                data: JSON.stringify({ ClassID: _ddl2, SessionID: _ddl4, StudentID: StdData }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "InsertSuccessful") {
                        fn_resetform();
                        FormSuccessError1("Promoted successfully.", "Success", "errorBlock", "div_Scroll");
                    }

                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        });
    </script>
}

