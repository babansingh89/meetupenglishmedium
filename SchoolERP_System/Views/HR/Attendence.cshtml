
@{
    ViewBag.Title = "Employee Attendence";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: visible;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    .card-body-modern .form-group { margin-bottom: 14px; }
    .required-star { color: #e53e3e; margin-left: 2px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }

    .btn-modern {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 28px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .btn-modern:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .btn-outline {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        padding: 10px 24px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
    }
    .btn-outline:hover {
        background: #f8fafc;
        color: #1e293b;
        border-color: #cbd5e1;
    }

    #tblMapping {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblMapping thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping thead th:last-child { border-right: none !important; }
    #tblMapping tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping tbody tr:nth-child(even) { background: #fafcfe; }
    #tblMapping tbody tr:hover { background: #eef6ff; }
    #tblMapping input[type="checkbox"] {
        accent-color: #0089b3;
        width: 15px;
        height: 15px;
        cursor: pointer;
    }
    #tblMapping input[type="checkbox"]:disabled { opacity: .5; cursor: not-allowed; }
    #tblMapping .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 6px 10px;
        height: 34px;
        width: 110px;
        display: inline-block;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    #tblMapping .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
        outline: none;
    }
    #tblMapping .form-control[disabled] {
        background: #f8fafc;
        color: #94a3b8;
        cursor: not-allowed;
    }
    #tblMapping .form-control::placeholder {
        color: #94a3b8 !important;
        font-size: 12px !important;
        opacity: 1 !important;
    }
    #tblMapping .form-control::-webkit-input-placeholder {
        color: #94a3b8 !important;
        opacity: 1 !important;
    }
    #tblMapping .form-control::-moz-placeholder {
        color: #94a3b8 !important;
        opacity: 1 !important;
    }
    #tblMapping .form-control:-ms-input-placeholder {
        color: #94a3b8 !important;
    }

    .ui-timepicker-wrapper,
    .ui-timepicker-list {
        z-index: 9999 !important;
    }
    .ui-timepicker-wrapper {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        box-shadow: 0 8px 24px rgba(0,0,0,.1) !important;
        background: #fff !important;
        overflow-y: auto !important;
        max-height: 200px;
    }
    .ui-timepicker-list li {
        padding: 7px 14px !important;
        font-size: 13px !important;
        color: #1e293b !important;
        border-bottom: 1px solid #f1f5f9 !important;
    }
    .ui-timepicker-list li:hover,
    .ui-timepicker-list li.ui-timepicker-selected {
        background: #eef6ff !important;
        color: #0089b3 !important;
    }

    #tblMapping_wrapper .dataTables_length label,
    #tblMapping_wrapper .dataTables_filter label,
    #tblMapping_wrapper .dataTables_info,
    #tblMapping_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblMapping_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblMapping_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblMapping_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }

    #tblMapping_wrapper.time-hint-wrap {
        position: relative;
    }
    #timeHint {
        position: absolute;
        top: -16px;
        right: 0;
        margin: 0;
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-calendar-check"></i></span>
                <span class="header-title">Employee Attendence</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">Attendence.Date<span class="required-star">*</span></label>
                            <input type="text" class="form-control dateFormat" id="txtAttendenceDate">
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-group">
                            <button class="btn btn-modern" style="margin-top: 25px;" id="btnSearch"><i class="bi bi-search"></i> Search</button>
                        </div>
                    </div>
                </div>
                <div id="stlist" class="row">
                    <div class="col-lg-12">
                        <p id="timeHint" style="color:#c0392b; font-size:12px; font-weight:600;">* For precise time entry, you may type the time manually.</p>
                        <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblMapping">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="chkAll" /></th>
                                    <th>Employee Code</th>
                                    <th>Employee Name</th>
                                    <th>Phone No</th>
                                    <th>In Time</th>
                                    <th>Out Time</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="action-bar" id="divActionBar" style="display:none;">
                    <button class="btn btn-modern" id="btnSave"><i class="bi bi-save"></i> Save</button>
                    <button class="btn btn-outline" id="btncancel"><i class="bi bi-x-circle"></i> Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section body_scripts{
    <script type="text/javascript">
        var ErrorDiv = $("#errorBlock").find(".alert.alert-danger.display-none");
        var SuccessDiv = $("#errorBlock").find(".alert.alert-success.display-none");
        function hideAlert() {
            SuccessDiv.hide();
            ErrorDiv.hide();
        }
        function fn_ParseDate(dt) {
            var parts = String(dt).split('/');
            if (parts.length !== 3) return null;
            var day = parseInt(parts[0], 10);
            var mon = parseInt(parts[1], 10) - 1;
            var yr = parseInt(parts[2], 10);
            var date = new Date(yr, mon, day);
            return (date.getFullYear() === yr && date.getMonth() === mon && date.getDate() === day) ? date : null;
        }
        $(document).ready(function () {
            $('#stlist').hide();
            $('#txtAttendenceDate').datepicker('destroy').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true
            });
            var d = new Date();
            var currMonth = d.getMonth();
            var currYear = d.getFullYear();
            var day = d.getDate(); 
            var startDate = new Date(currYear, currMonth, day);
            $("#txtAttendenceDate").datepicker("setDate", startDate);

        });
       
        $('#tblMapping').find('tbody tr input:checkbox').click(function () {

            if ($(".chkRow").length == $(".chkRow:checked").length) {
                $("#chkAll").prop("checked", true);
            } else {
                $("#chkAll").prop("checked", false);
            }
        });
        $("#chkAll").click(function () {
            var checkAll = $("#chkAll").prop('checked');
            if (checkAll) {
                $(".chkRow").prop("checked", true);
            } else {
                $(".chkRow").prop("checked", false);
            }
        });

        $(document).on('click', '#btncancel', function () {
            var url = '@Url.Action("Attendence", "HR")';
            window.location.href = url;
        });
        $(document).on('click', '#btnSearch', function () {
            hideAlert();
                       var _from = $('#txtAttendenceDate').val();
            if (_from == '') {
                FormSuccessError1("Please select Date.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
       
var TodayDate = new Date();
            var endDate = fn_ParseDate($("#txtAttendenceDate").val());
            
            if (endDate > TodayDate) {
                FormSuccessError1("Please select Correct Date.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            
            $.ajax({
                type: "POST",
                url: '/HR/viewAttendacne',
                data: JSON.stringify({ From: _from }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {

                    $('#tblMapping tbody').empty();
                    $.each(data, function (rowIndex, val) {

                        var row = '';
                        row += '<tr id=' + val.EM_EmpId + ' eaid=' + val.EAID + '>';
                        if (val.IsPresent == '1' || val.IsPresent == '1')
                            row += '<td><input type="checkbox" class="chkRow" checked ' + (val.Attendance_Type === "A" ? "disabled" : "") + ' Attendance_Type=' + val.Attendance_Type +'   /></td>';
                        else
                            row += '<td><input type="checkbox" class="chkRow" Attendance_Type=' + val.Attendance_Type +' /></td>';
                        row += '<td>' + val.EM_EmpCode + '</td>';
                        row += '<td>' + val.EM_EmpName + '</td>';
                        row += '<td>' + val.EM_EmpContactNo + '</td>';
                        if (val.InTime == '')
                            row += '<td><input type="textbox" id="expenses_sum1" placeholder="HH:mm:ss" class="form-control timepicker" value="' + (val.InTime || '') + '" ></td>';
                        else
                            row += '<td><input type="textbox" id="expenses_sum1" placeholder="HH:mm:ss" ' + (val.Attendance_Type === "A" ? "disabled" : "")  +' class="form-control timepicker" value="' + (val.InTime || '') + '" ></td>';

                        if (val.OutTime == '')
                            row += '<td><input type="textbox" id="expenses_sum2" placeholder="HH:mm:ss" class="form-control timepicker" value="' + (val.OutTime || '') + '" ></td>';
                        else
                            row += '<td><input type="textbox" id="expenses_sum2" placeholder="HH:mm:ss" ' + (val.Attendance_Type === "A" ? "disabled" : "") + ' class="form-control timepicker" value="' + (val.OutTime || '') + '" ></td>';

                        row += '</tr>';
                        $('#tblMapping tbody').append(row);
                    });
                    $('.timepicker').timepicker({
                        timeFormat: 'h:mm:ss p',
                        interval: 5,
                        minTime: '07',
                        maxTime: '11:00pm',
                        startTime: '07:00',
                        dynamic: false,
                        dropdown: true,
                        scrollbar: true
                    });
                    $('#stlist').show();
                    $('#divActionBar').show();
                    if ($.fn.dataTable.isDataTable('#tblMapping')) {
                        table = $('#tblMapping').DataTable();
                    }
                    else {
                        table = $('#tblMapping').DataTable({
                            paging: false
                        });
                    }
                    $('#tblMapping_wrapper').addClass('time-hint-wrap');
                    $('#timeHint').appendTo('#tblMapping_wrapper');
                    //$('#tblMapping').dataTable({ paging: false });
                }

            });
        });
        function fn_resetform() {

            //$('#txtAttendenceDate').val('');
            $('#tblMapping tbody').empty();
            $('#stlist').hide();
            $('#divActionBar').hide();
        }

        function fn_TimeToMinutes(t) {
            if (t == null || t == '') return 0;
            var parts = t.trim().toLowerCase().split(/:| /);
            var h = parseInt(parts[0], 10) || 0;
            var m = parseInt(parts[1], 10) || 0;
            var s = parseFloat(parts[2], 10) || 0;
            var ampm = parts[3];
            if (ampm === 'pm' && h !== 12) h += 12;
            if (ampm === 'am' && h === 12) h = 0;
            return h * 60 + m + (s / 60);
        }

        $(document).on('input', '.timepicker', function () {
            var d = this.value.replace(/[^\d]/g, '').slice(0, 6);
            this.value = d.length > 4 ? d.slice(0, 2) + ':' + d.slice(2, 4) + ':' + d.slice(4)
                     : d.length > 2 ? d.slice(0, 2) + ':' + d.slice(2)
                     : d;
        });

        $(document).on('change changeTime', '#expenses_sum2', function () {
            var $row = $(this).closest('tr');
            var inTime = $row.find('#expenses_sum1').val();
            var outTime = $(this).val();
            if (inTime === '' && outTime !== '') {
                alert('Out Time cannot be entered without In Time.');
                $(this).val('');
                return;
            }
            if (inTime !== '' && outTime !== '') {
                var inMins = fn_TimeToMinutes(inTime);
                var outMins = fn_TimeToMinutes(outTime);
                if (outMins === inMins) {
                    alert('In Time and Out Time should not be the same.');
                    $(this).val('');
                }
                else if (outMins < inMins) {
                    alert('Out Time must be greater than In Time.');
                    $(this).val('');
                }
            }
        });

        $(document).on("click", "#btnSave", function () {
            var _ddl1 = $('#txtAttendenceDate').val();
          
            var rowCount1 = $('#tblMapping >tbody >tr').length;

            if (_ddl1 == '' || _ddl1 == '-1') {
                FormSuccessError1("Please select Date.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            var TodayDate = new Date();
            var endDate = fn_ParseDate($("#txtAttendenceDate").val());
          
            if (endDate > TodayDate) {
                FormSuccessError1("Please select Correct Date.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            var StdData = [];
            var chkCnt = 0;
            var outErrCnt = 0;
            var outErrMsg = '';

            $('#tblMapping > tbody > tr').each(function () {

                var tr_id = $(this).attr('id');
                var eaid = $(this).attr('eaid');
                var v6 = $(this).find('td:eq(4)').find("#expenses_sum1").val(); // Get the time/attendance value
                var v7 = $(this).find('td:eq(5)').find("#expenses_sum2").val();
                var _ddl1 = $('#txtAttendenceDate').val(); // Get the attendance date

                var Attendance_Type = $(this).find('.chkRow:checked').attr('Attendance_Type');

                var chklen = $(this).find('.chkRow:checked').length;

                if (chklen > 0 && v6 !== '' && v7 !== '') {
                    var inMins = fn_TimeToMinutes(v6);
                    var outMins = fn_TimeToMinutes(v7);
                    var empName = $(this).find('td:eq(2)').text();
                    if (outMins === inMins) {
                        outErrCnt++;
                        outErrMsg = "In Time and Out Time should not be the same for " + empName + ".";
                    }
                    else if (outMins < inMins) {
                        outErrCnt++;
                        outErrMsg = "Out Time must be greater than In Time for " + empName + ".";
                    }
                }

                if (Attendance_Type != 'A') {
                    if (chklen > 0) { // Only process selected (checked) employees
                        if (v6 === '') {
                            if (v7 !== '') {
                                var empName2 = $(this).find('td:eq(2)').text();
                                outErrCnt++;
                                outErrMsg = "Out Time cannot be entered without In Time for " + empName2 + ".";
                            } else {
                                chkCnt++; // Selected employee but no time entered
                            }
                        } else {
                            // In Time present: Out Time is optional
                            StdData.push({
                                'EmpID': tr_id,
                                'EAID': eaid,
                                'IsPresent': '1',
                                'InTime': v6,
                                'OutTime': v7,
                                'AttendanceDate': _ddl1,
                                'Attendance_Type': 'M'
                            });
                        }
                    }
                }
            });

            if (outErrCnt > 0) {
                FormSuccessError1(outErrMsg, "Error", "errorBlock", "div_Scroll");
                return false;
            }

            if (chkCnt > 0 || StdData.length === 0) {
                FormSuccessError1("Please select employee and enter attendance time.", "Error", "errorBlock", "div_Scroll");
                return false;
            }

            console.log(StdData);


           // return false;
            $.ajax({
                type: "POST",
                url: '@Url.Action("saveAttendacne", "HR")',
                data: JSON.stringify({ Emp: StdData, From: _ddl1 }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "InsertSuccessful") {
                        fn_resetform();

                        FormSuccessError1("Attendance Generated Successfully.", "Success", "errorBlock", "div_Scroll");

                    }

                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        });
    </script>
}




