                <button class="btn btn-outline" id="btncancel"><i class="bi bi-x-circle"></i> Cancel</button>
            </div>
        </div>
    </div>
</div>

@section body_scripts{
    <script type="text/javascript">
        var ErrorDiv = $("#errorBlock").find(".alert.alert-danger.display-none");
        var SuccessDiv = $("#errorBlock").find(".alert.alert-success.display-none");
        function hideAlert() {
            SuccessDiv.hide();
            ErrorDiv.hide();
        }
        var _boundYear;
        function fn_bindMonths() {
            _boundYear = new Date().getFullYear();
            var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            $("#ddlMonthList").empty().append('<option selected="selected" value="0">Select</option>');
            for (var i = 1; i <= 12; i++) {
                $("#ddlMonthList").append($("<option/>").val(i).text(months[i - 1] + " - " + _boundYear));
            }
            $("#ddlMonthList").trigger("change");
        }
        $(document).ready(function () {
            $("#ddlMonthList").select2({
                placeholder: "Select",
                width: '100%',
                dropdownParent: $("#salaryEntryOverlay")
            });
            $("#ddlDesignationList").select2({
                placeholder: "Select"
            });
            $("#ddlTeacherList").select2({
                placeholder: "Select"
            });
            $("#ddlEarnDeduct").select2({
                placeholder: "Select",
                width: '100%',
                dropdownParent: $("#salaryEntryOverlay")
            });
            fn_bindMonths();

            $.ajax({
                type: "POST",
                url: '/HR/BindDesignation',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    $("#ddlDesignationList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlDesignationList").append($("<option/>").val(this.DesID).text(this.DesName));
                        });
                    }
                    $("#ddlDesignationList").trigger("change");
                }
            });

        });

        $("#ddlMonthList").change(function () {
            hideAlert();
        });
        function fn_closeEntryPopup() {
            $('#salaryEntryOverlay').removeClass('show');
            $('#tblEntries tbody').empty();
            fn_recalcTotals();
            _editKey = null;
            $('#btnAddEntry').html('<i class="bi bi-plus-lg"></i> Add');
            $('#txtAmount').val('');
            $('#ddlEarnDeduct').val('0').trigger('change');
        }
        $(document).on('click', '#btncancel', function () {
            fn_closeEntryPopup();
        });
        $('#salaryEntryOverlay').on('click', function (e) {
            if (e.target === this) fn_closeEntryPopup();
        });
        $("#ddlDesignationList").change(function () {
            var ID = $('option:selected', this).val();
            $("#ddlTeacherList").empty().append('<option selected="selected" value="0">Select</option>');
            if (ID == '' || ID <= 0) {
                $("#ddlTeacherList").trigger("change");
                return false;
            }
            $.ajax({
                type: "POST",
                url: '/HR/BindTeacher',
                data: JSON.stringify({ Id: ID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlTeacherList").append($("<option/>").val(this.EM_EmpId).text(this.EM_EmpName));
                        });
                    }
                    $("#ddlTeacherList").trigger("change");
                }
            });
        });
        var _editKey = null;
        $(document).on('input', '#txtAmount', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
        $(document).on('click', '#btnAddEntry', function () {
            var key = $('#ddlEarnDeduct').val();
            var label = $('#ddlEarnDeduct option:selected').text();
            var amt = $.trim($('#txtAmount').val());
            hideAlert();
            if (key == '' || key == '0' || key == null) {
                showCustomAlert("Please select Earning/Deduction.", 'warning');
                return false;
            }
            if (amt == '') {
                showCustomAlert("Please enter Amount.", 'warning');
                return false;
            }
            if (isNaN(amt)) {
                showCustomAlert("Please enter valid Amount.", 'warning');
                return false;
            }
            var type = label.slice(-3) == '(D)' ? 'D' : 'E';
            if (_editKey != null && _editKey != key && $('#tblEntries tbody tr[data-key="' + key + '"]').length > 0) {
                showCustomAlert(label.split('-(')[0] + " already added. Same Earning/Deduction can not be added twice.", 'warning');
                return false;
            }
            if (_editKey != null) {
                $('#tblEntries tbody tr[data-key="' + _editKey + '"]').remove();
                _editKey = null;
                $('#btnAddEntry').html('<i class="bi bi-plus-lg"></i> Add');
            }
            if ($('#tblEntries tbody tr[data-key="' + key + '"]').length > 0) {
                showCustomAlert(label.split('-(')[0] + " already added. Same Earning/Deduction can not be added twice.", 'warning');
                return false;
            }
            var row = '<tr data-key="' + key + '" data-type="' + type + '">';
            row += '<td>' + label + '</td>';
            row += '<td>' + parseInt(amt) + '</td>';
            row += '<td><button type="button" class="btn-action-icon btn-edit btnEditEntry" title="Edit"><i class="bi bi-pencil-square"></i></button>';
            row += ' <button type="button" class="btn-action-icon btn-delete btnDeleteEntry" title="Delete"><i class="bi bi-trash3"></i></button></td>';
            row += '</tr>';
            $('#tblEntries tbody').append(row);
            fn_recalcTotals();
            $('#txtAmount').val('');
            $('#ddlEarnDeduct').val('0').trigger('change');
        });
        $(document).on('click', '.btnEditEntry', function () {
            var tr = $(this).closest('tr');
            _editKey = tr.attr('data-key');
            $('#ddlEarnDeduct').val(_editKey).trigger('change');
            $('#txtAmount').val(tr.find('td:eq(1)').text());
            $('#btnAddEntry').html('<i class="bi bi-check-lg"></i> Update');
        });
        $(document).on('click', '.btnDeleteEntry', function () {
            var tr = $(this).closest('tr');
            var label = tr.find('td:eq(0)').text().split('-(')[0];
            var doDelete = function () {
                if (tr.attr('data-key') == _editKey) {
                    _editKey = null;
                    $('#btnAddEntry').html('<i class="bi bi-plus-lg"></i> Add');
                    $('#txtAmount').val('');
                    $('#ddlEarnDeduct').val('0').trigger('change');
                }
                tr.remove();
                fn_recalcTotals();
            };
            if (typeof showCustomAlert === 'function' && showCustomAlert.length >= 3) {
                showCustomAlert("Are you sure you want to delete " + label + " entry?", 'warning', doDelete);
            } else if (confirm("Are you sure you want to delete this entry?")) {
                doDelete();
            }
        });
        function fn_recalcTotals() {
            var totE = 0, totD = 0;
            $('#tblEntries tbody tr').each(function () {
                var amt = parseInt($(this).find('td:eq(1)').text()) || 0;
                if ($(this).attr('data-type') == 'D') { totD += amt; } else { totE += amt; }
            });
            $('#totEarn').text(totE);
            $('#totDeduction').text(totD);
            $('#totNetSalary').text(totE - totD);
        }
        function fn_resetform() {

            $('#ddlMonthList').select2("val", '0');
            fn_bindMonths();
            $('#ddlDesignationList').val('0').trigger("change");
            $('#ddlTeacherList').empty().append('<option selected="selected" value="0">Select</option>').trigger("change");
            $('#tblEntries tbody').empty();
            fn_recalcTotals();
            $('#salaryEntryOverlay').removeClass('show');
            $('#salaryHistorySection').hide();
            $('#tblSalaryHistory tbody').empty();
            _editKey = null;
            $('#btnAddEntry').html('<i class="bi bi-plus-lg"></i> Add');
            $('#txtAmount').val('');
            $('#ddlEarnDeduct').val('0').trigger('change');
        }

        $(document).on("click", "#btnPaySalary", function () {
            var _month = $('#ddlMonthList').val();
            var _empid = $('#ddlTeacherList').val();
            hideAlert();
            //if (_month == '' || _month == '0' || _month == null) {
            //    FormSuccessError1("Please select Month.", "Error", "errorBlock", "div_Scroll");
            //    return false;
            //}
            if (_empid == '' || _empid == '0' || _empid == null) {
                FormSuccessError1("Please select Teacher.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            $('#tblEntries tbody').empty();
            fn_recalcTotals();
            _editKey = null;
            $('#btnAddEntry').html('<i class="bi bi-plus-lg"></i> Add');
            $('#txtAmount').val('');
            $('#ddlEarnDeduct').val('0').trigger('change');
            $('#salaryEntryOverlay').addClass('show');
        });

        function fn_loadSalaryHistory() {
            var _desgtypeid = $('#ddlDesignationList').val();
            var _empid = $('#ddlTeacherList').val();
            hideAlert();
            if (_desgtypeid == '' || _desgtypeid == '0' || _desgtypeid == null) {
                FormSuccessError1("Please select Designation Type.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            if (_empid == '' || _empid == '0' || _empid == null) {
                FormSuccessError1("Please select Teacher.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("searchEmpWiseSalary", "HR")',
                data: JSON.stringify({ desgtypeid: _desgtypeid, empid: _empid }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    var $tb = $('#tblSalaryHistory tbody').empty();
                    if (response == null || response.Data == null || response.Data.length == 0) {
                        $('#salaryHistorySection').hide();
                        showCustomAlert((response && response.ResponseMessage) ? response.ResponseMessage : "No salary found for selected employee.", 'warning');
                        return;
                    }
                    var curM = new Date().getMonth() + 1;
                    var curY = new Date().getFullYear();
                    $.each(response.Data, function (i, v) {
                        var m = parseInt(v.MonthID) || 0;
                        var y = parseInt(v.YearID) || 0;
                        var isCurrent = (m == curM && y == curY);
                        var action = isCurrent
                            ? '<button type="button" class="btn-action-icon btn-edit btnEditHistory" data-month="' + m + '" data-year="' + y + '" title="Edit Salary"><i class="bi bi-pencil-square"></i></button> '
                            : '<button type="button" class="btn-action-icon btn-edit" disabled title="Edit available only for current month"><i class="bi bi-pencil-square"></i></button> ';
                        action += '<button type="button" class="btn-action-icon btn-print btnPrintHistory" data-month="' + m + '" data-year="' + y + '" title="Print Salary"><i class="bi bi-printer"></i></button>';
                        var row = '<tr data-month="' + m + '" data-year="' + y + '">' +
                            '<td>' + (v.EM_EmpName || '') + '</td>' +
                            '<td>' + (v.MonthName || '') + ' ' + y + '</td>' +
                            '<td>' + (parseInt(v.TotalEarnings) || 0) + '</td>' +
                            '<td>' + (parseInt(v.TotalDeductions) || 0) + '</td>' +
                            '<td>' + (parseInt(v.NetSalary) || 0) + '</td>' +
                            '<td>' + (v.ProcessedDate || '') + '</td>' +
                            '<td style="text-align:center;">' + action + '</td></tr>';
                        $tb.append(row);
                    });
                    $('#salaryHistorySection').show();
                },
                error: function () {
                    $('#salaryHistorySection').hide();
                    showCustomAlert("No salary found for selected employee.", 'warning');
                }
            });
        }
        $(document).on("click", "#btnSearch", fn_loadSalaryHistory);

        $(document).on("click", ".btnEditHistory", function () {
            var $tr = $(this).closest('tr');
            var m = $tr.attr('data-month');
            var y = $tr.attr('data-year');
            var _desgtypeid = $('#ddlDesignationList').val();
            var _empid = $('#ddlTeacherList').val();
            hideAlert();
            if (!m || m == '0' || !y) { return false; }
            $.ajax({
                type: "POST",
                url: '@Url.Action("searchSalaryProcess", "HR")',
                data: JSON.stringify({ desgtypeid: _desgtypeid, empid: _empid, strMonth: String(m), strYear: String(y) }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == null || response.Data == null || response.Data.length == 0) {
                        showCustomAlert((response && response.ResponseMessage) ? response.ResponseMessage : "No salary details found.", 'warning');
                        return;
                    }
                    $('#tblEntries tbody').empty();
                    $.each(response.Data, function (i, v) {
                        var label = v.EDName || ('Component ' + v.EDID);
                        var isD = /-\(D\)/i.test(label) || (parseInt(v.EDID) >= 6);
                        var row = '<tr data-key="' + v.EDID + '" data-type="' + (isD ? 'D' : 'E') + '">' +
                            '<td>' + label + '</td>' +
                            '<td>' + (parseInt(v.EDAmount) || 0) + '</td>' +
                            '<td><button type="button" class="btn-action-icon btn-edit btnEditEntry" title="Edit"><i class="bi bi-pencil-square"></i></button>' +
                            ' <button type="button" class="btn-action-icon btn-delete btnDeleteEntry" title="Delete"><i class="bi bi-trash3"></i></button></td></tr>';
                        $('#tblEntries tbody').append(row);
                    });
                    fn_recalcTotals();
                    $('#ddlMonthList').val(String(m)).trigger('change');
                    _editKey = null;
                    $('#btnAddEntry').html('<i class="bi bi-plus-lg"></i> Add');
                    $('#txtAmount').val('');
                    $('#ddlEarnDeduct').val('0').trigger('change');
                    $('#salaryEntryOverlay').addClass('show');
                },
                error: function () {
                    showCustomAlert("No salary details found.", 'warning');
                }
            });
        });

        $(document).on("click", ".btnPrintHistory", function () {
            var $tr = $(this).closest('tr');
            var m = $tr.attr('data-month');
            var y = $tr.attr('data-year');
            var empName = $.trim($tr.find('td:eq(0)').text());
            var _desgtypeid = $('#ddlDesignationList').val();
            var _empid = $('#ddlTeacherList').val();
            hideAlert();
            if (!m || m == '0' || !y) { return false; }
            $.ajax({
                type: "POST",
                url: '@Url.Action("searchSalaryProcess", "HR")',
                data: JSON.stringify({ desgtypeid: _desgtypeid, empid: _empid, strMonth: String(m), strYear: String(y) }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == null || response.ResponseCode != "1" || response.Data == null || response.Data.length == 0) {
                        showCustomAlert((response && response.ResponseMessage) ? response.ResponseMessage : "No salary details found.", 'warning');
                        return;
                    }
                    var earn = [], ded = [], totE = 0, totD = 0;
                    $.each(response.Data, function (i, v) {
                        var label = v.EDName || ('Component ' + v.EDID);
                        var amt = parseInt(v.EDAmount) || 0;
                        var isD = /-\(D\)/i.test(label) || (parseInt(v.EDID) >= 6);
                        label = label.replace(/-\([ED]\)/i, '');
                        if (isD) { ded.push({ n: label, a: amt }); totD += amt; } else { earn.push({ n: label, a: amt }); totE += amt; }
                    });
                    var rowsHtml = '';
                    var maxRows = Math.max(earn.length, ded.length);
                    for (var i = 0; i < maxRows; i++) {
                        rowsHtml += '<tr><td>' + (earn[i] ? earn[i].n : '') + '</td><td class="num">' + (earn[i] ? earn[i].a : '') + '</td>' +
                            '<td>' + (ded[i] ? ded[i].n : '') + '</td><td class="num">' + (ded[i] ? ded[i].a : '') + '</td></tr>';
                    }
                    var monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                    var monthName = monthNames[(parseInt(m) || 1) - 1];
                    var win = window.open('', '_blank', 'width=800,height=600');
                    if (!win) { showCustomAlert("Please allow pop-ups to print the salary slip.", 'warning'); return; }
                    win.document.write('<html><head><title>Salary Slip - ' + empName + ' - ' + monthName + ' ' + y + '</title><style>' +
                        'body{font-family:Segoe UI,Arial,sans-serif;margin:24px;color:#1e293b;}' +
                        'h1{font-size:20px;margin:0 0 2px;color:#006d8f;}' +
                        '.sub{font-size:13px;color:#64748b;margin-bottom:18px;}' +
                        '.meta{margin-bottom:14px;font-size:13px;}.meta b{color:#0f172a;}' +
                        'table{width:100%;border-collapse:collapse;font-size:13px;}' +
                        'th{background:#0089b3;color:#fff;padding:8px 10px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;}' +
                        'td{padding:7px 10px;border-bottom:1px solid #e2e8f0;}' +
                        'td.num,th.num{text-align:right;width:90px;}' +
                        'tfoot td{font-weight:700;border-top:2px solid #0089b3;border-bottom:none;background:#f6fbfe;}' +
                        '.net td{background:linear-gradient(135deg,#eef6ff,#e2eef7);color:#005b78;font-size:14px;}' +
                        '@@media print{body{margin:0;}}' +
                        '</style></head><body>' +
                        '<h1>Salary Slip</h1><div class="sub">Period: ' + monthName + ' ' + y + '</div>' +
                        '<div class="meta">Employee Name: <b>' + empName + '</b></div>' +
                        '<table><thead><tr><th>Earnings</th><th class="num">Amount</th><th>Deductions</th><th class="num">Amount</th></tr></thead>' +
                        '<tbody>' + rowsHtml + '</tbody>' +
                        '<tfoot><tr><td>Total Earnings</td><td class="num">' + totE + '</td><td>Total Deductions</td><td class="num">' + totD + '</td></tr>' +
                        '<tr class="net"><td colspan="2">Net Salary (Earning - Deduction)</td><td colspan="2" class="num">' + (totE - totD) + '</td></tr></tfoot>' +
                        '</table></body></html>');
                    win.document.close();
                    win.focus();
                    win.print();
                },
                error: function () {
                    showCustomAlert("No salary details found.", 'warning');
                }
            });
        });

        $(document).on("click", "#btnSave", function () {
            var _month = $('#ddlMonthList').val();
            var _year = String(_boundYear);
            var _desgtypeid = $('#ddlDesignationList').val();
            var _empid = $('#ddlTeacherList').val();

            if (_month == '' || _month == '0' || _month == null) {
                showCustomAlert("Please select Month.", 'warning');
                return false;
            }
            var curM = new Date().getMonth() + 1;
            var curY = new Date().getFullYear();
            if (parseInt(_year) != curY || parseInt(_month) != curM) {
                showCustomAlert("Salary can be processed only for the current month.", 'warning');
                return false;
            }
            if (_desgtypeid == '' || _desgtypeid == '0' || _desgtypeid == null) {
                showCustomAlert("Please select Designation Type.", 'warning');
                return false;
            }
            if (_empid == '' || _empid == '0' || _empid == null) {
                showCustomAlert("Please select Teacher.", 'warning');
                return false;
            }

            var Entries = [];
            $('#tblEntries > tbody > tr').each(function () {
                Entries.push({
                    EDID: $(this).attr('data-key'),
                    EDAmount: $.trim($(this).find('td:eq(1)').text())
                });
            });

            if (Entries.length == 0) {
                showCustomAlert("Please add atleast one Earning/Deduction entry.", 'warning');
                return false;
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("saveSalaryProcess", "HR")',
                data: JSON.stringify({ Entries: Entries, strMonth: _month, strYear: _year, desgtypeid: _desgtypeid, empid: _empid }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response != null && response.ResponseCode == "1") {
                        fn_resetform();
                        FormSuccessError1("Salary saved successfully !!", "Success", "errorBlock", "div_Scroll");
                    }
                    else {
                        showCustomAlert((response && response.ResponseMessage) ? response.ResponseMessage : "Error. Try again later.", 'warning');
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    showCustomAlert("Error occurred while saving Salary.", 'error');
                    return false;
                }
            });
        });
    </script>
}


