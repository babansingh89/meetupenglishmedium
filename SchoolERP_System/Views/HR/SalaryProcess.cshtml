</div>

<div id="salaryEntryOverlay" class="salary-entry-overlay">
    <div class="salary-entry-box">
        <div class="se-header">
            <span class="se-icon"><i class="bi bi-cash-stack"></i></span>
            <span class="se-title">Process Salary</span>
        </div>
        <div class="se-body">
            <div class="row se-form-row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Month<span class="required-star">*</span></label>
                        <select id="ddlMonthList" class="form-control">
                            <option value="0">Select</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Earning/Deduction<span class="required-star">*</span></label>
                        <select id="ddlEarnDeduct" class="form-control">
                            <option value="0">Select</option>
                            <option value="1">Basic-(E)</option>
                            <option value="2">HRA-(E)</option>
                            <option value="3">Medical-(E)</option>
                            <option value="4">Conveyance-(E)</option>
                            <option value="5">Special Allowance-(E)</option>
                            <option value="6">PF-(D)</option>
                            <option value="7">Professional Tax-(D)</option>
                            <option value="8">Loan Installment-(D)</option>
                            <option value="9">Advance Recovery-(D)</option>
                            <option value="10">Other Deduction-(D)</option>
