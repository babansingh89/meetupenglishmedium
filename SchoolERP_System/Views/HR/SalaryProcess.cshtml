                        <div class="form-group">
                            <button type="button" id="btnPaySalary" class="btn btn-modern" style="margin-top:25px;" title="Process Salary"><i class="bi bi-cash-coin"></i> Pay Salary</button>
                        </div>
                    </div>*@

                </div>
                <div id="salaryHistorySection" class="row" style="display:none;">
