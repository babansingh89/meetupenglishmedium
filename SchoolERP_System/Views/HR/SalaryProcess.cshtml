
@{
    ViewBag.Title = "Salary Process";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}




<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: visible;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    .card-body-modern .form-group { margin-bottom: 14px; }
    .required-star { color: #e53e3e; margin-left: 2px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }

    .card-body-modern .select2-container--default .select2-selection--single {
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 6px !important;
        height: 38px !important;
        box-shadow: none !important;
        background: #fff;
        font-family: 'Roboto', sans-serif;
        font-size: 13px;
        transition: border-color .2s, box-shadow .2s;
    }
    .card-body-modern .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 35px !important;
        padding-top: 0 !important;
        color: #0f172a;
        padding-left: 12px;
        font-family: 'Roboto', sans-serif;
        font-size: 13px;
    }
    .card-body-modern .select2-container--default .select2-selection--single .select2-selection__rendered:empty,
    .card-body-modern .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #94a3b8 !important;
    }
    .card-body-modern .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
        right: 8px;
        width: 24px;
    }
    .card-body-modern .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #64748b transparent transparent transparent !important;
        border-width: 5px 5px 0 5px !important;
    }
    .card-body-modern .select2-container--default.select2-container--open .select2-selection--single,
    .card-body-modern .select2-container--default .select2-selection--single:focus-within {
        border-color: #0089b3 !important;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1) !important;
    }
    .card-body-modern .select2-container--default .select2-selection--single:hover {
        background-color: #fff !important;
        color: #0f172a !important;
        border-color: #cbd5e1 !important;
        box-shadow: none !important;
    }

    .btn-modern {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 28px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .btn-modern:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .btn-outline {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        padding: 10px 24px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
    }
    .btn-outline:hover {
        background: #f8fafc;
        color: #1e293b;
        border-color: #cbd5e1;
    }

    #tblEntries {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblEntries thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblEntries thead th:last-child { border-right: none !important; width: 120px; text-align: center; }
    #tblEntries tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        vertical-align: middle !important;
    }
    #tblEntries tbody tr:nth-child(even) { background: #fafcfe; }
    #tblEntries tbody tr:hover { background: #eef6ff; }
    #tblEntries tbody td:nth-child(2) { font-weight: 600; color: #0f172a; }
    #tblEntries tbody td:last-child { text-align: center; white-space: nowrap; }
    #tblEntries tfoot th {
        background: #f8fafc;
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
        padding: 10px 18px !important;
        border-top: 2px solid #0089b3 !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblEntries tfoot th:nth-child(2) { text-align: right; color: #006d8f; }
    #tblEntries tfoot tr:last-child th {
        background: linear-gradient(135deg, #eef6ff, #e2eef7);
        color: #005b78;
        font-size: 14px;
    }
    .btn-action-icon {
        border: none;
        background: transparent;
        padding: 4px 6px;
        margin: 0 2px;
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        border-radius: 5px;
        transition: all .2s;
    }
    .btn-action-icon.btn-edit { color: #0089b3; }
    .btn-action-icon.btn-edit:hover { background: #e0f2fe; color: #006d8f; }
    .btn-action-icon.btn-print { color: #16a34a; }
    .btn-action-icon.btn-print:hover { background: #e8f7ee; color: #12813c; }
    .btn-action-icon.btn-delete { color: #e53e3e; }
    .btn-action-icon.btn-delete:hover { background: #fee2e2; color: #c53030; }
    .btn-action-icon[disabled] {
        opacity: .35;
        cursor: not-allowed;
        pointer-events: none;
    }

    #tblSalaryHistory {
        width: 100% !important;
        margin-top: 18px;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblSalaryHistory thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 16px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblSalaryHistory thead th:last-child { border-right: none !important; }
    #tblSalaryHistory tbody td {
        padding: 10px 16px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblSalaryHistory tbody tr:nth-child(even) { background: #fafcfe; }
    #tblSalaryHistory tbody tr:hover { background: #eef6ff; }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
    }

    .salary-entry-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(2,10,20,.55);
        z-index: 999998;
        display: none;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: center;
        justify-content: center;
    }
    .salary-entry-overlay.show {
        display: -webkit-flex !important;
        display: flex !important;
    }
    .salary-entry-box {
        width: 60%;
        max-width: 94%;
        max-height: 92vh;
        overflow: auto;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 25px 70px rgba(0,0,0,.35);
        -webkit-animation: salEntryIn .3s ease;
        animation: salEntryIn .3s ease;
    }
    .se-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 22px;
        color: #fff;
        background: linear-gradient(135deg, #0089b3, #006d8f);
    }
    .se-icon {
        width: 32px;
        height: 32px;
        line-height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,.22);
        text-align: center;
        font-size: 15px;
        flex-shrink: 0;
    }
    .se-title {
        font-size: 17px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }
    .se-body { padding: 20px 24px 24px; }
    .se-form-row { margin-bottom: 6px; }
    .salary-entry-box .form-control {
        height: 36px;
        border-radius: 6px;
        font-size: 13px;
        border-color: #e2e8f0;
        box-shadow: none;
    }
    .salary-entry-box .select2-container--default .select2-selection--single {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        height: 36px !important;
    }
    .salary-entry-box .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 36px !important;
    }
    .salary-entry-box .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
    }
    .salary-entry-box .select2-container {
        width: 100% !important;
    }
    .salary-entry-overlay .select2-dropdown,
    .salary-entry-overlay .select2-container--open .select2-dropdown {
        z-index: 1000001 !important;
    }
    @@-webkit-keyframes salEntryIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
    @@keyframes salEntryIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-cash-stack"></i></span>
                <span class="header-title">Salary Process</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">Designation Type</label>
                            <select class="form-control" id="ddlDesignationList">
                                <option value="0">Select</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">Teacher Name</label>
                            <select class="form-control" id="ddlTeacherList">
                                <option value="0">Select</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
