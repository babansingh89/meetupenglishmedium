                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Amount<span class="required-star">*</span></label>
                        <input type="text" id="txtAmount" class="form-control Numeric" placeholder="0">
                    </div>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-modern" style="margin-top:25px;width:100%;" id="btnAddEntry"><i class="bi bi-plus-lg"></i> Add</button>
                </div>
            </div>
            <table class="table table-bordered table-hover table-condensed" id="tblEntries">
                <thead>
                    <tr>
                        <th>Earning/Deduction</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <th>Total Earning</th>
                        <th id="totEarn">0</th>
                        <th></th>
                    </tr>
                    <tr>
                        <th>Total Deduction</th>
                        <th id="totDeduction">0</th>
                        <th></th>
                    </tr>
                    <tr>
