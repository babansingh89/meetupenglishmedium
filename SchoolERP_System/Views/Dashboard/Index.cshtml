@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<style>
    .dash-stats { margin: -10px -8px 20px; display: flex; flex-wrap: wrap; }
    .dash-stat { width: 25%; padding: 8px; }
    .dash-stat-inner { background: #fff; border-radius: 12px; padding: 22px 20px 18px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); display: flex; align-items: center; transition: all .25s ease; position: relative; overflow: hidden; }
    .dash-stat-inner:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
    .dash-stat-inner .stat-bar { position: absolute; top: 0; left: 0; width: 4px; height: 100%; border-radius: 0 2px 2px 0; }
    .dash-stat-icon { width: 52px; height: 52px; min-width: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff; margin-right: 16px; }
    .dash-stat-body { flex: 1; min-width: 0; }
    .dash-stat-body h4 { font-size: 13px; font-weight: 500; color: #718096; text-transform: uppercase; letter-spacing: .6px; margin: 0 0 4px; }
    .dash-stat-body h3 { font-size: 28px; font-weight: 700; color: #1a202c; margin: 0 0 2px; line-height: 1.2; }
    .dash-stat-body a { font-size: 12px; color: #0089b3; font-weight: 500; }
    .dash-stat-body a:hover { color: #006d8f; text-decoration: none; }

    .dash-grid { display: flex; flex-wrap: wrap; margin: 0 -8px; }
    .dash-grid-col { width: 50%; padding: 0 8px; }
    .dash-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden; margin-bottom: 16px; }
    .dash-card-header { padding: 16px 20px; border-bottom: 1px solid #edf2f7; display: flex; align-items: center; }
    .dash-card-header i { font-size: 16px; color: #0089b3; margin-right: 10px; }
    .dash-card-header span { font-size: 15px; font-weight: 600; color: #2d3748; }
    .dash-card-body { padding: 16px 20px; }
    .dash-card-body .monthly { border: none; }

    .notif-item { padding: 14px 0; border-bottom: 1px solid #f0f4f8; display: flex; align-items: flex-start; }
    .notif-item:last-child { border-bottom: none; }
    .notif-icon { width: 38px; height: 38px; min-width: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fff; margin-right: 12px; }
    .notif-icon i.fa { font-size: 16px; color: #fff; margin: 0; cursor: default; line-height: 1; }
    .notif-icon.blue { background: linear-gradient(135deg,#0089b3,#006d8f); }
    .notif-icon.red { background: linear-gradient(135deg,#e53e3e,#c53030); }
    .notif-icon.green { background: linear-gradient(135deg,#38a169,#276749); }
    .notif-icon.orange { background: linear-gradient(135deg,#d69e2e,#b7791f); }
    .notif-icon.gray { background: linear-gradient(135deg,#718096,#4a5568); }
    .notif-content { flex: 1; min-width: 0; }
    .notif-content .notif-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; }
    .notif-content .notif-head strong { font-size: 13px; color: #2d3748; font-weight: 600; }
    .notif-content .notif-head small { font-size: 11px; color: #a0aec0; }
    .notif-content p { font-size: 13px; color: #718096; margin: 0; line-height: 1.5; }

    .attendance-table { width: 100%; border-collapse: collapse; }
    .attendance-table th { background: #f7fafc; padding: 10px 12px; font-size: 12px; font-weight: 600; color: #4a5568; text-transform: uppercase; letter-spacing: .5px; text-align: center; border-bottom: 2px solid #e2e8f0; }
    .attendance-table td { padding: 10px 12px; font-size: 14px; font-weight: 600; color: #2d3748; text-align: center; border-bottom: 1px solid #edf2f7; }
    .attendance-table td.present { color: #38a169; }
    .attendance-table td.absent { color: #e53e3e; }

    .dash-marquee { height: 420px; overflow: hidden; }

    @@media (max-width: 991px) { .dash-stat { width: 50%; } .dash-grid-col { width: 100% !important; } }
    @@media (max-width: 600px) { .dash-stat { width: 100%; } }
</style>

<div class="dash-stats">
    <div class="dash-stat">
        <div class="dash-stat-inner">
            <div class="stat-bar" style="background:linear-gradient(180deg,#e53e3e,#c53030);"></div>
            <div class="dash-stat-icon" style="background:linear-gradient(135deg,#e53e3e,#c53030);"><i class="fa fa-users"></i></div>
            <div class="dash-stat-body">
                <h4>Students</h4>
                <h3><span id="student">0</span></h3>
                <a href="@Url.Action("Registration", "Student")">All Students &rarr;</a>
            </div>
        </div>
    </div>
    <div class="dash-stat">
        <div class="dash-stat-inner">
            <div class="stat-bar" style="background:linear-gradient(180deg,#38a169,#276749);"></div>
            <div class="dash-stat-icon" style="background:linear-gradient(135deg,#38a169,#276749);"><i class="fa fa-thumbs-up"></i></div>
            <div class="dash-stat-body">
                <h4>Present Today</h4>
                <h3><span id="present">0</span></h3>
                <a href="#" class="Iconattendacne">View Attendance &rarr;</a>
            </div>
        </div>
    </div>
    <div class="dash-stat">
        <div class="dash-stat-inner">
            <div class="stat-bar" style="background:linear-gradient(180deg,#0089b3,#006d8f);"></div>
            <div class="dash-stat-icon" style="background:linear-gradient(135deg,#0089b3,#006d8f);"><i class="fa fa-credit-card"></i></div>
            <div class="dash-stat-body">
                <h4>Collection</h4>
                <h3><span id="absent">0</span></h3>
                <a href="@Url.Action("StudentFeesCollectionList", "Transaction")">Month Collection &rarr;</a>
            </div>
        </div>
    </div>
    <div class="dash-stat">
        <div class="dash-stat-inner">
            <div class="stat-bar" style="background:linear-gradient(180deg,#d69e2e,#b7791f);"></div>
            <div class="dash-stat-icon" style="background:linear-gradient(135deg,#d69e2e,#b7791f);"><i class="fa fa-shopping-cart"></i></div>
            <div class="dash-stat-body">
                <h4>Expenses</h4>
                <h3><span id="due">0</span></h3>
                <a href="@Url.Action("ExpensesEntry", "Expenses")">Month Expense &rarr;</a>
            </div>
        </div>
    </div>
</div>

<div class="dash-grid">
    <div class="dash-grid-col">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="fa fa-calendar-o"></i>
                <span>Calendar</span>
            </div>
            <div class="dash-card-body">
                <div class="monthly" id="mycalendar"></div>
            </div>
        </div>
    </div>
    <div class="dash-grid-col">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="fa fa-bell-o"></i>
                <span>Notifications</span>
            </div>
            <div class="dash-card-body" style="padding:0 20px;">
                <div class="dash-marquee">
                    <marquee direction="up" height="400px" onmouseover="stop();" onMouseOut="start();">
                        <div id="dvNotice"></div>
                    </marquee>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="dash-grid" style="margin-top:8px;">
    <div class="dash-grid-col" style="width:33.33%;">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="fa fa-bar-chart"></i>
                <span>Monthly</span>
            </div>
            <div class="dash-card-body">
                <div id="graph7"></div>
            </div>
        </div>
    </div>
    <div class="dash-grid-col" style="width:33.33%;">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="fa fa-bar-chart"></i>
                <span>Daily</span>
            </div>
            <div class="dash-card-body">
                <div id="graph8"></div>
            </div>
        </div>
    </div>
    <div class="dash-grid-col" style="width:33.33%;">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="fa fa-line-chart"></i>
                <span>Yearly</span>
            </div>
            <div class="dash-card-body">
                <div id="graph9"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="AssignModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border:none;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background:linear-gradient(135deg,#0089b3,#006d8f);border-radius:14px 14px 0 0;border:none;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
                <h4 class="modal-title" id="myModalLabel" style="color:#fff;font-size:16px;font-weight:600;margin:0;">
                    <a href="@Url.Action("TakeAttendance", "DailyAttendance")" style="color:#fff;text-decoration:none;">Today's Attendance &rarr;</a>
                </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color:#fff;opacity:.8;text-shadow:none;font-size:22px;"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body" style="padding:20px;">
                @Html.Partial("~/Views/Shared/Modal_SuccessError.cshtml")
                <table class="attendance-table" id="tblAssignClass" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Total</th>
                            <th>Present</th>
                            <th>Absent</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section body_scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            jQuery('.small-graph-box').hover(function () {
                jQuery(this).find('.box-button').fadeIn('fast');
            }, function () {
                jQuery(this).find('.box-button').fadeOut('fast');
            });
            jQuery('.small-graph-box .box-close').click(function () {
                jQuery(this).closest('.small-graph-box').fadeOut(200);
                return false;
            });

            Morris.Area({
                element: 'graph7',
                data: [
                    { x: '2013-03-30 22:00:00', y: 3, z: 3 },
                    { x: '2013-03-31 00:00:00', y: 2, z: 0 },
                    { x: '2013-03-31 02:00:00', y: 0, z: 2 },
                    { x: '2013-03-31 04:00:00', y: 4, z: 4 }
                ],
                xkey: 'x',
                ykeys: ['y', 'z'],
                labels: ['Y', 'Z']
            });

            /* data stolen from http://howmanyleft.co.uk/vehicle/jaguar_'e'_type */
            var day_data = [
                { "period": "2016-10-01", "licensed": 3407, "sorned": 660 },
                { "period": "2016-09-30", "licensed": 3351, "sorned": 629 },
                { "period": "2016-09-29", "licensed": 3269, "sorned": 618 },
                { "period": "2016-09-20", "licensed": 3246, "sorned": 661 },
                { "period": "2016-09-19", "licensed": 3257, "sorned": 667 },
                { "period": "2016-09-18", "licensed": 3248, "sorned": 627 },
                { "period": "2016-09-17", "licensed": 3171, "sorned": 660 },
                { "period": "2016-09-16", "licensed": 3171, "sorned": 676 },
                { "period": "2016-09-15", "licensed": 3201, "sorned": 656 },
                { "period": "2016-09-10", "licensed": 3215, "sorned": 622 }
            ];
            Morris.Bar({
                element: 'graph8',
                data: day_data,
                xkey: 'period',
                ykeys: ['licensed', 'sorned'],
                labels: ['Licensed', 'SORN'],
                xLabelAngle: 60
            });

            var day_data = [
                { "elapsed": "I", "value": 34 },
                { "elapsed": "II", "value": 24 },
                { "elapsed": "III", "value": 3 },
                { "elapsed": "IV", "value": 12 },
                { "elapsed": "V", "value": 13 },
                { "elapsed": "VI", "value": 22 },
                { "elapsed": "VII", "value": 5 },
                { "elapsed": "VIII", "value": 26 },
                { "elapsed": "IX", "value": 12 },
                { "elapsed": "X", "value": 19 }
            ];
            Morris.Line({
                element: 'graph9',
                data: day_data,
                xkey: 'elapsed',
                ykeys: ['value'],
                labels: ['value'],
                parseTime: false
            });

            //CHARTS
            function gd(year, day, month) {
                return new Date(year, month - 1, day).getTime();
            }

            graphArea2 = Morris.Area({
                element: 'hero-area',
                padding: 10,
                behaveLikeLine: true,
                gridEnabled: false,
                gridLineColor: '#dddddd',
                axes: true,
                resize: true,
                smooth: true,
                pointSize: 0,
                lineWidth: 0,
                fillOpacity: 0.85,
                data: [
                    { period: '2015 Q1', iphone: 2668, ipad: null, itouch: 2649 },
                    { period: '2015 Q2', iphone: 15780, ipad: 13799, itouch: 12051 },
                    { period: '2015 Q3', iphone: 12920, ipad: 10975, itouch: 9910 },
                    { period: '2015 Q4', iphone: 8770, ipad: 6600, itouch: 6695 },
                    { period: '2016 Q1', iphone: 10820, ipad: 10924, itouch: 12300 },
                    { period: '2016 Q2', iphone: 9680, ipad: 9010, itouch: 7891 },
                    { period: '2016 Q3', iphone: 4830, ipad: 3805, itouch: 1598 },
                    { period: '2016 Q4', iphone: 15083, ipad: 8977, itouch: 5185 },
                    { period: '2017 Q1', iphone: 10697, ipad: 4470, itouch: 2038 },

                ],
                lineColors: ['#eb6f6f', '#926383', '#eb6f6f'],
                xkey: 'period',
                redraw: true,
                ykeys: ['iphone', 'ipad', 'itouch'],
                labels: ['All Visitors', 'Returning Visitors', 'Unique Visitors'],
                pointSize: 2,
                hideHover: 'auto',
                resize: true
            });
        });

        $(window).load(function () {
            $('#mycalendar').monthly({
                mode: 'event',
            });

            $('#mycalendar2').monthly({
                mode: 'picker',
                target: '#mytarget',
                setWidth: '250px',
                startHidden: true,
                showTrigger: '#mytarget',
                stylePast: true,
                disablePast: true
            });
            //switch (window.location.protocol) {
            //    case 'http:':
            //    case 'https:':
            //        break;
            //    case 'file:':
            //        alert('Just a heads-up, events will not work when run locally.');
            //}

            fn_Bindtbl("0", "SuperAdmin");
        });
        function fn_Bindtbl(_Id, Type) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("viewDashboard", "Dashboard")',
                data: JSON.stringify({ ID: _Id, Type: Type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (Type == "SuperAdmin") {
                        if (data[0] != null) {
                            $("#student").text(data[0][0].StudentCount);
                            $("#present").text(data[0][0].PresentCount);
                            $("#absent").text(data[0][0].AbsentCount);
                            $("#due").text(data[0][0].DueCount);
                        }
                        if (data[1] != null) {
                            $.each(data[1], function (rowIndex, val) {
                                var icons = ['fa-envelope-o','fa-quote-left','fa-comments-o','fa-bell-o','fa-rss'];
                                var colors = ['blue','red','green','orange','gray'];
                                var idx = rowIndex % 5;
                                var row = '<div class="notif-item">' +
                                    '<div class="notif-icon ' + colors[idx] + '"><i class="fa ' + icons[idx] + '"></i></div>' +
                                    '<div class="notif-content">' +
                                    '<div class="notif-head"><strong>' + val.NTitle + '</strong><small>' + val.NDate + '</small></div>' +
                                    '<p>' + val.NDescription + '</p></div></div>';
                                $('#dvNotice').append(row);
                            });
                        }
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        }

        $(document).on("click", ".Iconattendacne", function () {
            $("#AssignModal").modal();
            bindUserAssigntbl();
        });
        function bindUserAssigntbl() {
            $.ajax({
                type: "POST",
                url: '/Dashboard/ViewAttendance',
                data: JSON.stringify({ Type: "Dashboard" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $('#tblAssignClass tbody').empty();
                    if (data.length > 0) {
                        $.each(data, function (rowIndex, r) {
                            $('#tblAssignClass tbody').append("<tr><td>" + r.ClassName + "</td><td>" + r.SectionName + "</td><td>" + r.Total + "</td><td class='present'>" + r.Present + "</td><td class='absent'>" + r.Absent + "</td></tr>");
                        });
                    }
                    //$('#tblAssignClass').dataTable();
                }
            });
        }
    </script>
}