    <!-- CSS -->
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/bootstrap.min.css" />
    <link type='text/css' rel="stylesheet" href='https://fonts.googleapis.com/css?family=Roboto:400,100,100italic,300,300italic,400italic,500,500italic,700,700italic,900,900italic'>
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/font.css" />
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/font-awesome.css">
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/style.css" />
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/style-responsive.css" />
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/morris.css" />
    <link type='text/css' rel="stylesheet" href="~/Content/assets/css/monthly.css">
    <link type='text/css' rel="stylesheet" href="~/Content/assets/Plugins/datatables/css/datatables.min.css" />
    <link type='text/css' rel="stylesheet" href="~/Content/assets/Plugins/datatables/css/datatables.bootstrap.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css">
    <link type='text/css' rel="stylesheet" href="~/Content/assets/Plugins/Confirmation/jquery-confirm.css" />
    <link href="~/Content/Select2/select2-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Select2/select2.min.css" rel="stylesheet" />
    <!-- Datepicker -->
    <link href="~/Content/vendor/bootstrap-datepicker/css/datepicker.css" rel="stylesheet" />
    @*<script src="~/Content/Common/JS/timepicki.js"></script>*@
    @*<link href="~/Content/Common/Css/style.css" rel="stylesheet" />*@
    @*<link href="~/Content/Common/Css/timepicki.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <style>
        .display-none { display: none; }
        .select2-container { width: 100% !important; }
        .m-b-10 { margin-bottom: 10px; }
        .m-t-10 { margin-top: 10px; }
        .modal-header { background: linear-gradient(135deg, #0089b3, #006d8f); color: #fff; border-radius: 4px 4px 0 0; }
        .modal-header .close { color: #fff; opacity: .8; text-shadow: none; }
        .modal-header .modal-title { color: #fff; }

        .top-nav .dropdown-menu { border: none; border-radius: 10px; box-shadow: 0 8px 30px rgba(0,0,0,0.15); padding: 8px; min-width: 190px; margin-top: 10px; }
        .top-nav .dropdown-menu > li > a { padding: 10px 14px; border-radius: 8px; font-size: 14px; color: #2d3748; display: flex; align-items: center; transition: all .15s ease; }
        .top-nav .dropdown-menu > li > a i { font-size: 16px; width: 22px; text-align: center; margin-right: 12px; color: #718096; transition: color .15s; }
        .top-nav .dropdown-menu > li > a:hover { background: #f0f4f8; color: #0089b3; }
        .top-nav .dropdown-menu > li > a:hover i { color: #0089b3; }
        .top-nav .dropdown-menu > li:not(:last-child) > a { border-bottom: 1px solid #f0f4f8; margin-bottom: 2px; }

        .top-nav img { border-radius: 50%; width: 36px; height: 36px; object-fit: cover; border: 2px solid rgba(255,255,255,0.3); }
        .top-nav .username { font-size: 14px; font-weight: 500; color: #fff; margin-left: 6px; }
        .top-nav .caret { border-top-color: rgba(255,255,255,0.7); }

        /* ===== Global Font ===== */
        body, .wrapper, #main-content, .container, .container-fluid,
        table, input, select, textarea, button, .btn,
        .modal-content, .panel, .well, .form-control,
        .dropdown-menu, .nav, .navbar, .breadcrumb, .pagination,
        .label, .badge, .alert, .list-group, .progress,
        .panel-heading, .panel-body, .panel-footer,
        .modal-header, .modal-body, .modal-footer {
            font-family: 'Roboto', sans-serif !important;
        }

        /* ===== Sidebar Professional ===== */
        #sidebar, #sidebar :not(i) {
            font-family: 'Roboto', sans-serif !important;
        }
        #sidebar {
            background: linear-gradient(180deg, #0a2b3c 0%, #0f3a4f 100%) !important;
            box-shadow: 2px 0 20px rgba(0,0,0,0.15);
            width: 240px;
            z-index: 100;
        }
        #sidebar::-webkit-scrollbar { width: 4px; }
        #sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }
        .leftside-navigation { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.15) transparent; }
        ul.sidebar-menu { padding-top: 70px; }
        ul.sidebar-menu > li { border-bottom: 1px solid rgba(255,255,255,0.04); }
        ul.sidebar-menu > li:last-child { border-bottom: none; }
        ul.sidebar-menu li a {
            padding: 14px 16px 14px 20px;
            font-size: 13px;
            font-weight: 400;
            color: rgba(255,255,255,0.75);
            transition: all .25s ease;
            position: relative;
            border-left: 3px solid transparent;
        }
        ul.sidebar-menu li a:hover,
        ul.sidebar-menu li a:focus {
            background: rgba(255,255,255,0.06);
            color: #fff;
            border-left-color: #f0bcb4;
        }
        ul.sidebar-menu li a.active {
            background: rgba(0,137,179,0.15);
            color: #fff;
            border-left-color: #0089b3;
            font-weight: 500;
        }
        ul.sidebar-menu li a i {
            font-size: 15px;
            width: 22px;
            text-align: center;
            margin-right: 10px;
            color: rgba(255,255,255,0.5);
            transition: color .25s;
        }
        ul.sidebar-menu li a:hover i,
        ul.sidebar-menu li a.active i { color: #f0bcb4; }
        ul.sidebar-menu li a.active i { color: #0089b3; }

        /* Sub-menu */
        ul.sidebar-menu li ul.sub { background: rgba(0,0,0,0.15); padding: 4px 0; }
        ul.sidebar-menu li ul.sub li { background: transparent !important; }
        ul.sidebar-menu li ul.sub li a {
            padding: 9px 16px 9px 20px;
            font-size: 12.5px;
            color: rgba(255,255,255,0.6);
            border-left: 2px solid transparent;
            transition: all .25s ease;
            display: flex;
            align-items: center;
        }
        ul.sidebar-menu li ul.sub li a i.sub-icon {
            font-size: 11px;
            width: 18px;
            text-align: center;
            margin-right: 8px;
            color: rgba(255,255,255,0.3);
            transition: color .25s;
        }
        ul.sidebar-menu li ul.sub li a:hover {
            background: rgba(255,255,255,0.05);
            color: #fff;
            border-left-color: #8b5c7e;
        }
        ul.sidebar-menu li ul.sub li a:hover i.sub-icon { color: #f0bcb4; }
        ul.sidebar-menu li ul.sub li.active a {
            color: #fff;
            background: rgba(139,92,126,0.12);
            border-left-color: #8b5c7e;
        }
        ul.sidebar-menu li ul.sub li.active a i.sub-icon { color: #8b5c7e; }

        /* dcjq accordion arrow */
        #sidebar .dcjq-icon {
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            height: 18px;
            width: 18px;
            line-height: 18px;
            text-align: center;
            top: 14px;
            right: 12px;
            background-image: none !important;
            font-family: 'FontAwesome' !important;
            font-size: 10px;
            color: rgba(255,255,255,0.4);
            transition: all .25s;
        }
        #sidebar .dcjq-icon::before { content: "\f105"; }
        #sidebar .active .dcjq-icon { background-image: none !important; background: rgba(0,137,179,0.2); color: #0089b3; }
        #sidebar .active .dcjq-icon::before { content: "\f107"; }
        #sidebar li.sub-menu:hover > a > .dcjq-icon { color: #f0bcb4; }

        /* Logout special */
        ul.sidebar-menu li a[href*="Logout"] { border-top: 1px solid rgba(255,255,255,0.06); margin-top: 4px; }
        ul.sidebar-menu li a[href*="Logout"] i { color: rgba(240,188,180,0.6); }
        ul.sidebar-menu li a[href*="Logout"]:hover i { color: #f0bcb4; }

        /* ===== Header Professional ===== */
        .header {
            background: linear-gradient(135deg, #0089b3 0%, #006080 100%) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,0.12);
            height: 64px;
        }
        .brand {
            background: linear-gradient(135deg, #8b5c7e 0%, #6d4662 100%) !important;
            width: 240px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        a.logo {
            font-size: 20px !important;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: capitalize;
            color: #fff;
            margin: 0 !important;
            float: none !important;
        }
        .sidebar-toggle-box {
            position: absolute;
            right: -14px;
            top: 50%;
            margin: 0;
            -webkit-transform: translateY(-50%);
            transform: translateY(-50%);
            width: 28px;
            height: 28px;
            background: #f0bcb4;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
            border: 2px solid #fff;
        }
        .sidebar-toggle-box .fa-bars {
            font-size: 12px;
            color: #fff;
            padding: 0;
        }
        .sidebar-toggle-box:hover {
            background: #e8a89e;
            -webkit-transform: translateY(-50%) scale(1.08);
            transform: translateY(-50%) scale(1.08);
        }
        .top-nav {
            height: 64px;
            display: flex;
            align-items: center;
            margin-top: 0 !important;
            padding: 0 20px;
        }
        .top-nav #sch {
            margin: 0 auto 0 0 !important;
            padding: 0;
            font-size: 14px !important;
            font-weight: 500 !important;
            color: rgba(255,255,255,0.9) !important;
            letter-spacing: .3px;
            display: inline-flex;
            align-items: center;
            line-height: 1;
            background: none !important;
        }
        .top-nav ul.pull-right {
            margin: 0;
            display: flex;
            align-items: center;
        }
        .top-nav ul.top-menu > li { margin-left: 6px; }
        .top-nav ul.top-menu > li > a {
            border: none !important;
            background: rgba(255,255,255,0.12) !important;
            border-radius: 30px !important;
            padding: 5px 14px 5px 10px !important;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background .2s;
        }
        .top-nav ul.top-menu > li > a:hover,
        .top-nav ul.top-menu > li > a:focus {
            background: rgba(255,255,255,0.22) !important;
            border: none !important;
        }
        .top-nav img {
            width: 32px !important;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255,255,255,0.4);
        }
        .top-nav .username {
            font-size: 13px;
            font-weight: 500;
            color: #fff !important;
        }
        .top-nav .caret {
            border-top-color: rgba(255,255,255,0.7) !important;
            border-bottom-color: rgba(255,255,255,0.7) !important;
        }
        .top-nav .dropdown-menu.extended.logout { top: 48px; right: 0 !important; left: auto !important; }

        .monthly { border: none !important; background: transparent !important; }
        .monthly-header { background: linear-gradient(135deg, #0089b3, #006d8f) !important; border-radius: 10px 10px 0 0 !important; padding: 14px 16px !important; min-height: 50px !important; }
        .monthly-header-title { color: #fff !important; font-size: 15px !important; font-weight: 600 !important; }
        .monthly-prev, .monthly-next { background: rgba(255,255,255,0.2) !important; border-radius: 6px !important; color: #fff !important; width: 28px !important; height: 28px !important; line-height: 28px !important; text-align: center !important; font-size: 13px !important; transition: background .2s; }
        .monthly-prev:hover, .monthly-next:hover { background: rgba(255,255,255,0.35) !important; }
        .monthly-day { border-radius: 6px !important; transition: background .2s; }
        .monthly-day-title { font-size: 11px !important; font-weight: 600 !important; color: #718096 !important; text-transform: uppercase !important; padding: 6px 0 !important; }
        .monthly-day.monthly-today { background: rgba(0,137,179,0.1) !important; color: #0089b3 !important; font-weight: 700 !important; }
        .monthly-day.monthly-today span { background: #0089b3 !important; color: #fff !important; border-radius: 50% !important; width: 28px !important; height: 28px !important; line-height: 28px !important; display: inline-block !important; }
        .monthly-day span { font-size: 13px !important; }
        .monthly-day-event { background: rgba(0,137,179,0.08) !important; border-radius: 6px !important; }
        .monthly-day-pick span { color: #a0aec0 !important; }
        .monthly-reset { background: transparent !important; }
    </style>
</head>
