
@{
    ViewBag.Title = "Employee Attendance";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}


<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-body-modern {
        padding: 20px 24px 24px;
        font-family: 'Roboto', sans-serif;
    }

    .card-body-modern .form-group { margin-bottom: 14px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    .card-body-modern .btn-print {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 28px;
        margin-top: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-body-modern .btn-print:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-clipboard-check"></i></span>
                <span class="header-title">Employee Attendance</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">From:<span style="color:red;">*</span></label>
                            <input type="text" class="form-control dateFormat" id="txtFrom">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">To:<span style="color:red;">*</span></label>
                            <input type="text" class="form-control dateFormat" id="txtTo">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">Designation Type:</label>
                            @Html.DropDownList("ddlDesignationList", (IList<SelectListItem>)ViewBag.DesignationList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">Teacher Name:</label>
                            @*@Html.DropDownList("ddlTeacherList", (IList<SelectListItem>)ViewBag.TeacherList, new { @class = "form-control" })*@
                            <select class="form-control" id="ddlTeacherList">
                                <option value="0">Select</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @{
                                string AppID = Convert.ToString(HttpContext.Current.Session["AppID"]).ToString();
                            }
                            <button class="btn btn-print" id="btnSave" AppId="@AppID">Generate</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section body_scripts{
    <script type="text/javascript">
        var ErrorDiv = $("#errorBlock").find(".alert.alert-danger.display-none");
        var SuccessDiv = $("#errorBlock").find(".alert.alert-success.display-none");
        function hideAlert() {
            SuccessDiv.hide();
            ErrorDiv.hide();
        }
        $(document).ready(function () {
            $("#ddlClassList").select2({
                placeholder: "Select"
            });
            $("#ddlSectionList").select2({
                placeholder: "Select"
            });
        });

        function fn_resetform() {
            $('#ddlClassList').select2("val", '');
            $('#ddlSectionList').select2("val", '');

        }
        $("#ddlDesignationList").change(function () {
            var ID = $('option:selected', this).val();
            if (ID == '' || ID <= 0) {
                return false;
            }
            $.ajax({
                type: "POST",
                url: '/Report/BindTeacher',
                data: JSON.stringify({ ID: ID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $("#ddlTeacherList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlTeacherList").append($("<option/>").val(this.EM_EmpId).text(this.EM_EmpName));
                        });
                    }
                }
            });
        });
        $(document).on("click", "#btnSave", function () {
            var _ddlTachrList = $('#ddlTeacherList').val();
            var _From = $('#txtFrom').val();
            var _To = $('#txtTo').val();
            //if (_ddlClassList == '' || _ddlClassList <= 0) {
            //    FormSuccessError1("Please select Class.", "Error", "errorBlock", "div_Scroll");
            //    return false;
            //}
            //if (_ddlSectionList == '' || _ddlSectionList <= 0) {
            //    FormSuccessError1("Please select Section.", "Error", "errorBlock", "div_Scroll");
            //    return false;
            //}

            @*$.ajax({
                type: "POST",
                url: '@Url.Action("PrintStudentRegistration", "Report")',
                data: JSON.stringify({ Class: _ddlClassList, Section: _ddlSectionList}),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (data == "Error") {
                        alert("Error! Try again later.");
                    }
                    else {
                        window.open(data);
                        //previewPdfDocument(data);
                    }
                },
                error: function (error) {
                    console.log(error);
                    //alert("Error! Try again later.");
                    window.location.href = "/Error";
                }
            });*@

            var AppID = $("#btnSave").attr('AppId');
            Print(AppID);
        });

        function Print(AppID) {
            var final = {}; var master = []; var detail = [];

            master.push({
                ReportName: "EmployeeAttendance.rpt",
                FileName: "Employee_Attendance_Report",
                AppID: AppID
            });

            detail.push({
                EmpID: $('#ddlTeacherList').val(),
                From: $('#txtFrom').val(),
                To: $('#txtTo').val(),
                DesigID: $('#ddlDesignationList').val(),
                AppID: AppID
            });

            final = {
                Master: master,
                Detail: detail
            }

            var left = ($(window).width() / 2) - (950 / 2),
                top = ($(window).height() / 2) - (650 / 2),
                popup = window.open("/OpenReport/OpenReports.aspx?ReportName=" + JSON.stringify(final), "popup", "width=950, height=650, top=" + top + ", left=" + left);
            popup.focus();
        }
    </script>
}




