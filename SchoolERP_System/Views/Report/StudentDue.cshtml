
@{
    ViewBag.Title = "Student Due";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}


<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-body-modern {
        padding: 20px 24px 24px;
        font-family: 'Roboto', sans-serif;
    }

    .card-body-modern .form-group { margin-bottom: 14px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
        .card-body-modern .btn-print {
            background: linear-gradient(135deg, #0089b3, #006d8f);
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            padding: 9px 28px;
            margin-top: 27px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all .2s;
            box-shadow: 0 2px 8px rgba(0,137,179,.2);
        }
    .card-body-modern .btn-print:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-card-checklist"></i></span>
                <span class="header-title">Student Due</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">Class Name</label>
                            @Html.DropDownList("ddlClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">Section Name</label>
                            <select id="ddlSectionList" class="form-control"> </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">Student Name</label>
                            <select id="ddlStudentList" class="form-control"> </select>
                            @*<select class="form-control" id="ddlStudentList">
            <option value="0">Select</option>
        </select>*@
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <button class="btn btn-print" id="btnPrint"><i class="bi bi-gear"></i>Generate</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section body_scripts{
    <script type="text/javascript">
        var ErrorDiv = $("#errorBlock").find(".alert.alert-danger.display-none");
        var SuccessDiv = $("#errorBlock").find(".alert.alert-success.display-none");
        function hideAlert() {
            SuccessDiv.hide();
            ErrorDiv.hide();
        }
        $(document).ready(function () {
            $("#ddlClassList").select2({
                placeholder: "Select"
            });
            $("#ddlSectionList").select2({
                placeholder: "Select"
            });
            $("#ddlStudentList").select2({
                placeholder: "Select"
            });
        });

        function fn_resetform() {
            $('#ddlClassList').select2("val", '');
            $('#ddlSectionList').select2("val", '');
            //$('#txtFrom').val('');
            //$('#txtTo').val('');
        }
        $("#ddlClassList").change(function () {
            var ID = $('option:selected', this).val();
            if (ID == '' || ID <= 0) {
                return false;
            }
            $.ajax({
                type: "POST",
                url: '/Student/BindStream',
                data: JSON.stringify({ ID: ID, Type: "Se" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $("#ddlSectionList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlSectionList").append($("<option/>").val(this.SectionID).text(this.SectionName));
                        });
                    }
                }
            });
        });
        $("#ddlSectionList").change(function () {
            var _ddlClassList = $('#ddlClassList').val();
            var _ddlSectionList = $('#ddlSectionList').val();
            $.ajax({
                type: "POST",
                url: '@Url.Action("viewStudentForAttendance", "Report")',
                data: JSON.stringify({ ClassID: _ddlClassList, SectionID: _ddlSectionList }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (response) {
                    $("#ddlStudentList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (response.Output === "success" && response.Data && response.Data.length > 0) {
                        $.each(response.Data, function () {
                            $("#ddlStudentList").append(
                                $("<option/>").val(this.SR_ID).text(this.SR_StudentName)
                            );
                        });

                    } else if (response.Output === "error") {
                        alert("Error: " + response.Message);
                    } else {
                        console.log(response.Message);
                    }
                }
            });
        });
        $(document).on("click", "#btnPrint", function () {
            var _ddlClassList = $('#ddlClassList').val();
            var _ddlSectionList = $('#ddlSectionList').val();
            //if (_ddlClassList == '' || _ddlClassList <= 0) {
            //    FormSuccessError1("Please select Class.", "Error", "errorBlock", "div_Scroll");
            //    return false;
            //}
            //if (_ddlSectionList == '' || _ddlSectionList <= 0) {
            //    FormSuccessError1("Please select Section.", "Error", "errorBlock", "div_Scroll");
            //    return false;
            //}

            Print();
            @*$.ajax({
                type: "POST",
                url: '@Url.Action("StudentDueWise", "Report")',
                data: JSON.stringify({ Class: _ddlClassList, Section: _ddlSectionList }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (data == "Error") {
                        alert("Error! Try again later.");
                    }
                    else {
                        window.open(data);
                        //previewPdfDocument(data);
                    }
                },
                error: function (error) {
                    console.log(error);
                    //alert("Error! Try again later.");
                    window.location.href = "/Error";
                }
            });*@
        });

        function Print() {

            var classVal = $('#ddlClassList').val();
            var sectionVal = $('#ddlSectionList').val();
            var studentVal = $('#ddlStudentList').val();

            var final = {}; var master = []; var detail = [];

            master.push({
                ReportName: "FeeCollection_DueReport.rpt",
                FileName: "Due_Report",
                AppID: ""
            });

            detail.push({
                ClassID: (!classVal || classVal == -1 || classVal == 0) ? 0 : parseInt(classVal, 10),
                SectionID: (!sectionVal || sectionVal == -1 || sectionVal == 0) ? 0 : parseInt(sectionVal, 10),
                SR_ID: (!studentVal || studentVal == -1 || studentVal == 0) ? 0 : parseInt(studentVal, 10),
                AppID: ""
            });

            final = {
                Master: master,
                Detail: detail
            }

            var left = ($(window).width() / 2) - (950 / 2),
                top = ($(window).height() / 2) - (650 / 2),
                popup = window.open("/OpenReport/OpenReports.aspx?ReportName=" + JSON.stringify(final), "popup", "width=950, height=650, top=" + top + ", left=" + left);
            popup.focus();
        }

    </script>
}




