@{
    ViewBag.Title = "Library Setting";
}

<style>
    .modal-header {
        background: rgb(240, 188, 180);
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-6">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <span class="pull-left">Library Settings</span>
            </div>
            <div class="panel-body">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="form-group">
                    <label for="txtIssueDays" class="control-label">Maximum Borrow Days:<span style="color:red;">*</span></label>
                    <input type="text" class="form-control Numeric" id="txtIssueDays" placeholder="e.g. 15">
                    <small class="text-muted">Days allowed for a book before it becomes overdue.</small>
                </div>
                <div class="form-group">
                    <label for="txtFinePerDay" class="control-label">Fine Per Overdue Day (Rs.):<span style="color:red;">*</span></label>
                    <input type="text" class="form-control Numeric" id="txtFinePerDay" placeholder="e.g. 5">
                    <small class="text-muted">Fine amount charged for each overdue day (calculated automatically on return).</small>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-primary" id="btnSave">Save</button>
                    <button type="button" class="btn btn-default" id="btnCancel">Reset</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section body_scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            fn_LoadSetting();
        });

        function fn_LoadSetting() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("viewLibSetting", "Library")',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $("#txtIssueDays").val(data[0].IssueDays);
                        $("#txtFinePerDay").val(data[0].FinePerDay);
                    }
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        $("#btnCancel").click(function () {
            fn_LoadSetting();
            HideSuccErrDiv();
        });

        $(document).on("click", "#btnSave", function () {
            HideSuccErrDiv();
            var _IssueDays = $.trim($("#txtIssueDays").val());
            var _FinePerDay = $.trim($("#txtFinePerDay").val());

            if (_IssueDays == "" || _IssueDays <= 0) {
                FormSuccessError("Please enter valid Borrow Days.", "Error", "errorBlock");
                return false;
            }
            if (_FinePerDay == "" || _FinePerDay < 0) {
                FormSuccessError("Please enter valid Fine amount.", "Error", "errorBlock");
                return false;
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("saveLibSetting", "Library")',
                data: JSON.stringify({ IssueDays: _IssueDays, FinePerDay: _FinePerDay }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "UpdateSuccessful") {
                        FormSuccessError("Settings saved successfully.", "Success", "errorBlock");
                    } else {
                        FormSuccessError("Error. Try again later.", "Error", "errorBlock");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });
        });
    </script>
}