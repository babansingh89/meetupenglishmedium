@{
    ViewBag.Title = "Library Member List";
}

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    #tblData {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblData thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblData thead th:last-child { border-right: none !important; }
    #tblData tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblData tbody tr:nth-child(even) { background: #fafcfe; }
    #tblData tbody tr:hover { background: #eef6ff; }
    #tblData i.fa {
        color: #64748b;
        margin-right: 10px;
        transition: color .2s;
        cursor: pointer;
    }
    #tblData i.fa:hover { color: #0089b3; }
    #tblData i.Icondelclass { color: #dc2626 !important; }

    #tblData_wrapper .dataTables_length label,
    #tblData_wrapper .dataTables_filter label,
    #tblData_wrapper .dataTables_info,
    #tblData_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblData_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblData_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblData_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblData_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblData_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblData_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }

    #MasterModal .modal-dialog { width: 780px; max-width: 95%; }
    #MasterModal .modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 25px 60px rgba(0,0,0,.15);
    }
    #MasterModal .modal-header {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 12px 12px 0 0;
        padding: 16px 24px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    #MasterModal .modal-title {
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: .2px;
    }
    #MasterModal .modal-header .close {
        color: rgba(255,255,255,.6);
        opacity: 1;
        text-shadow: none;
        font-size: 22px;
    }
    #MasterModal .modal-header .close:hover { color: #fff; opacity: 1; }
    #MasterModal .modal-body {
        padding: 24px;
        font-family: 'Roboto', sans-serif;
    }
    #MasterModal .form-group { margin-bottom: 14px; }
    #MasterModal .form-group label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    #MasterModal .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    #MasterModal .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #MasterModal .form-control:disabled,
    #MasterModal .form-control[disabled] {
        background: #eef2f6;
        cursor: not-allowed;
        opacity: .8;
    }
    #MasterModal .modal-footer {
        padding: 14px 24px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    #MasterModal .modal-footer .btn {
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        padding: 9px 20px;
        transition: all .2s;
    }
    #MasterModal .modal-footer .btn-primary {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        color: #fff;
    }
    #MasterModal .modal-footer .btn-primary:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
    }
    #MasterModal .modal-footer .btn-default {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        color: #475569;
    }
    #MasterModal .modal-footer .btn-default:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="fa fa-users"></i></span>
                <span class="header-title">Library Member List</span>
                <button class="btn btn-register openModal"><i class="fa fa-plus"></i> Add Member</button>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblData">
                    <thead>
                        <tr>
                            <th>Member Type</th>
                            <th>Reg No</th>
                            <th>Member Name</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Contact No</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdId" value="0" />
<input type="hidden" id="hdMemberRefID" value="0" />
<div class="modal fade" id="MasterModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="exampleModalLabel">Add/Update Library Member</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @Html.Partial("~/Views/Shared/Modal_SuccessError.cshtml")
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="recipient-name" class="control-label">Member Type:<span style="color:red;">*</span></label>
                            <select id="ddlMemberType" class="form-control">
                                <option value="Student">Student</option>
                                <option value="Staff">Staff</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="divStudent">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="recipient-name" class="control-label">Class:<span style="color:red;">*</span></label>
                                @Html.DropDownList("ddlClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="recipient-name" class="control-label">Section:<span style="color:red;">*</span></label>
                                <select id="ddlSectionList" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="recipient-name" class="control-label">Select Student:<span style="color:red;">*</span></label>
                                <select id="ddlStudentList" class="form-control"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="divStaff" style="display:none;">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="recipient-name" class="control-label">Select Staff:<span style="color:red;">*</span></label>
                                @Html.DropDownList("ddlStaffList", (IList<SelectListItem>)ViewBag.StaffList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="control-label">Reg No:</label>
                            <input type="text" class="form-control" id="txtRegNo">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="recipient-name" class="control-label">Member Name:<span style="color:red;">*</span></label>
                            <input type="text" class="form-control" id="txtMemberName">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="recipient-name" class="control-label">Gender:</label>
                            <select id="ddlGender" class="form-control">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="recipient-name" class="control-label">Contact No:</label>
                            <input type="text" class="form-control" id="txtContactNo">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section body_scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $("#ddlClassList").select2({
                placeholder: "Select"
            });
            $("#ddlSectionList").select2({
                placeholder: "Select"
            });
            $("#ddlStudentList").select2({
                placeholder: "Select"
            });
            $("#ddlStaffList").select2({
                placeholder: "Select"
            });
            fn_Bindtbl("0", "Select");
        });

        function fn_EnableDetailFields() {
            $("#txtRegNo").prop("disabled", false);
            $("#txtMemberName").prop("disabled", false);
            $("#ddlGender").prop("disabled", false);
            $("#txtContactNo").prop("disabled", false);
        }

        function fn_DisableDetailFields() {
            $("#txtRegNo").prop("disabled", true);
            $("#txtMemberName").prop("disabled", true);
            $("#ddlGender").prop("disabled", true);
            $("#txtContactNo").prop("disabled", true);
        }

        function fn_clearMemberDetail() {
            fn_EnableDetailFields();
            $("#hdMemberRefID").val('0');
            $("#txtRegNo").val('');
            $("#txtMemberName").val('');
            $("#ddlGender").val('');
            $("#txtContactNo").val('');
        }

        $("#ddlMemberType").change(function () {
            var _Type = $('option:selected', this).text();
            fn_clearMemberDetail();
            if (_Type == "Student") {
                $("#divStudent").show();
                $("#divStaff").hide();
                fn_resetMemberPicker();
            } else {
                $("#divStudent").hide();
                $("#divStaff").show();
                fn_resetMemberPicker();
            }
        });

        function fn_resetMemberPicker() {
            $("#ddlSectionList").empty().append('<option selected="selected" value="0">Select</option>');
            $("#ddlStudentList").empty().append('<option selected="selected" value="0">Select</option>');
            $("#ddlClassList").select2('val', '');
        }

        $("#ddlClassList").change(function () {
            var ID = $('option:selected', this).val();
            if (ID == '' || ID <= 0) {
                return false;
            }
            $("#ddlSectionList").empty().append('<option selected="selected" value="0">Select</option>');
            $("#ddlStudentList").empty().append('<option selected="selected" value="0">Select</option>');
            fn_clearMemberDetail();
            $.ajax({
                type: "POST",
                url: '/Student/BindStream',
                data: JSON.stringify({ ID: ID, Type: "Se" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlSectionList").append($("<option/>").val(this.SectionID).text(this.SectionName));
                        });
                    }
                }
            });
        });
        $("#ddlSectionList").change(function () {
            var _CID = $.trim($("#ddlClassList").val());
            var _SID = $('option:selected', this).val();
            if (_CID == '' || _CID <= 0) {
                return false;
            }
            if (_SID == '' || _SID <= 0) {
                return false;
            }
            $("#ddlStudentList").empty().append('<option selected="selected" value="0">Select</option>');
            fn_clearMemberDetail();
            $.ajax({
                type: "POST",
                url: '@Url.Action("BindStudent", "Library")',
                data: JSON.stringify({ CID: _CID, SID: _SID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlStudentList").append($("<option/>").val(this.SR_ID).text(this.SR_StudentName));
                        });
                    }
                }
            });
        });
        $("#ddlStudentList").change(function () {
            var _SR_ID = $('option:selected', this).val();
            if (_SR_ID == '' || _SR_ID <= 0) {
                fn_clearMemberDetail();
                return false;
            }
            fn_clearMemberDetail();
            $.ajax({
                type: "POST",
                url: '@Url.Action("BindStudent", "Library")',
                data: JSON.stringify({ CID: '', SID: _SR_ID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    fn_EnableDetailFields();
                    var _SectionID = data[0].SR_SectionID;
                    $("#ddlSectionList").select2('val', _SectionID);
                    $("#hdMemberRefID").val(data[0].SR_ID);
                    $("#txtMemberName").val(data[0].SR_StudentName);
                    $("#txtRegNo").val(data[0].SR_RegNo);
                    $("#ddlGender").val(data[0].SR_Gender);
                    $("#txtContactNo").val(data[0].SR_PhNo);
                    fn_DisableDetailFields();
                },
                error: function (error) {
                    return false;
                }
            });
        });
        $("#ddlStaffList").change(function () {
            var _Emp = $('option:selected', this);
            var _EmpID = _Emp.val();
            if (_EmpID == '' || _EmpID <= 0) {
                fn_clearMemberDetail();
                return false;
            }
            fn_clearMemberDetail();
            $("#hdMemberRefID").val(_EmpID);
            $("#txtMemberName").val(_Emp.text());
            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewEmployee", "HR")',
                data: JSON.stringify({ Id: _EmpID, Type: "SelectByID" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (data.length > 0) {
                        $("#txtRegNo").val(data[0].EM_EmpCode);
                        $("#ddlGender").val(data[0].EM_Gender);
                        $("#txtContactNo").val(data[0].EM_EmpContactNo);
                    }
                    fn_DisableDetailFields();
                },
                error: function (error) {
                    fn_DisableDetailFields();
                    return false;
                }
            });
        });

        $(document).on("click", ".openModal", function () {
            HideSuccErrDiv();
            ModalHideSuccErrDiv();
            fn_resetform();
            $("#MasterModal").modal();
        });

        $(document).on("click", ".Iconeditclass", function () {
            var _Id = $(this).attr('data-ID');
            $("#hdId").val(_Id);
            fn_Bindtbl(_Id, "SelectByID");
        });

        $(document).on("click", ".Icondelclass", function () {
            if (confirm("Are you sure want to delete?")) {
                var _Id = $(this).attr('data-ID');
                fn_del(_Id);
            }
        });

        $(document).on("click", "#btnSave", function () {
            ModalHideSuccErrDiv();
            var _Id = $.trim($("#hdId").val());
            var _MemberType = $.trim($("#ddlMemberType").val());
            var _MemberRefID = $.trim($("#hdMemberRefID").val());
            var _RegNo = $.trim($("#txtRegNo").val());
            var _MemberName = $.trim($("#txtMemberName").val());
            var _ClassID = $.trim($("#ddlClassList").val());
            var _SectionID = $.trim($("#ddlSectionList").val());
            var _Gender = $.trim($("#ddlGender").val());
            var _ContactNo = $.trim($("#txtContactNo").val());

            if (_MemberType == "Student") {
                if (_ClassID == "" || _ClassID <= 0) {
                    ModalPopupError("Please Select Class.", "Error", "M_errorBlock");
                    return false;
                }
                if (_SectionID == "" || _SectionID <= 0) {
                    ModalPopupError("Please Select Section.", "Error", "M_errorBlock");
                    return false;
                }
                if (_MemberRefID == "" || _MemberRefID <= 0) {
                    ModalPopupError("Please Select Student.", "Error", "M_errorBlock");
                    return false;
                }
            } else {
                if (_MemberRefID == "" || _MemberRefID <= 0) {
                    ModalPopupError("Please Select Staff.", "Error", "M_errorBlock");
                    return false;
                }
                _ClassID = "";
                _SectionID = "";
            }
            if (_MemberName == "") {
                ModalPopupError("Please enter Member Name.", "Error", "M_errorBlock");
                return false;
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("saveLibMember", "Library")',
                data: JSON.stringify({ Id: _Id, MemberType: _MemberType, MemberRefID: _MemberRefID, RegNo: _RegNo, MemberName: _MemberName, ClassID: _ClassID, SectionID: _SectionID, Gender: _Gender, ContactNo: _ContactNo }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "InsertSuccessful") {
                        fn_resetform();
                        ModalPopupError("Data Inserted successfully.", "Success", "M_errorBlock");
                        fn_Bindtbl("0", "Select");
                    }
                    else if (response == "UpdateSuccessful") {
                        fn_resetform();
                        ModalPopupError("Data updated successfully.", "Success", "M_errorBlock");
                        fn_Bindtbl("0", "Select");
                    }
                    else if (response == "MemberAlreadyExist") {
                        ModalPopupError("This member is already registered in library.", "Error", "M_errorBlock");
                        return false;
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });
        });

        function fn_Bindtbl(_Id, Type) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("viewLibMember", "Library")',
                data: JSON.stringify({ Id: _Id, Type: Type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (Type == "Select") {
                        $('#tblData tbody').empty();
                        $.each(data, function (rowIndex, val) {
                            var row = '';
                            row += '<tr>';
                            row += '<td>' + val.MemberType + '</td>';
                            row += '<td>' + val.RegNo + '</td>';
                            row += '<td>' + val.MemberName + '</td>';
                            row += '<td>' + val.ClassName + '</td>';
                            row += '<td>' + val.SectionName + '</td>';
                            row += '<td>' + val.ContactNo + '</td>';
                            row += '<td><i class="fa fa-edit Iconeditclass" data-ID="' + val.LibMemberID + '"></i><i class="fa fa-trash-o Icondelclass" data-ID="' + val.LibMemberID + '"></i></td>';
                            row += '</tr>';
                            $('#tblData tbody').append(row);
                        });
                        $('#tblData').dataTable();
                    }

                    if (Type == "SelectByID") {
                        fn_EnableDetailFields();
                        $('#btnSave').text("Update");
                        $("#ddlMemberType").val(data[0].MemberType).trigger('change');
                        $("#hdMemberRefID").val(data[0].MemberRefID);
                        $("#txtRegNo").val(data[0].RegNo);
                        $("#txtMemberName").val(data[0].MemberName);
                        $("#ddlGender").val(data[0].Gender);
                        $("#txtContactNo").val(data[0].ContactNo);
                        if (data[0].MemberType == "Student") {
                            $("#ddlClassList").select2('val', data[0].ClassID);
                            fn_BindSectionOnEdit(data[0].ClassID, data[0].SectionID);
                        } else {
                            $("#ddlStaffList").select2('val', data[0].MemberRefID);
                        }
                        fn_DisableDetailFields();
                        $("#MasterModal").modal();
                    }
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });
        }

        function fn_BindSectionOnEdit(ClassID, SectionID) {
            $.ajax({
                type: "POST",
                url: '/Student/BindStream',
                data: JSON.stringify({ ID: ClassID, Type: "Se" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $("#ddlSectionList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlSectionList").append($("<option/>").val(this.SectionID).text(this.SectionName));
                        });
                    }
                    $("#ddlSectionList").select2('val', SectionID);
                }
            });
        }

        function fn_del(Id) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("deleteLibMember", "Library")',
                data: JSON.stringify({ Id: Id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "deleteSuccessful") {
                        fn_Bindtbl("0", "Select");
                        FormSuccessError("Data deleted successfully.", "Success", "errorBlock");
                    }
                    else if (response == "memberHasIssuedBook") {
                        FormSuccessError("This member has pending issued book, can not delete.", "Error", "errorBlock");
                        return false;
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });
        };

        function fn_resetform() {
            fn_EnableDetailFields();
            $("#hdId").val('0');
            $("#hdMemberRefID").val('0');
            $("#ddlMemberType").val('Student');
            $("#divStudent").show();
            $("#divStaff").hide();
            fn_resetMemberPicker();
            $("#txtRegNo").val('');
            $("#txtMemberName").val('');
            $("#ddlGender").val('');
            $("#txtContactNo").val('');
            $('#btnSave').text("Save");
        }
    </script>
}