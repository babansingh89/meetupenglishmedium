@{
    ViewBag.Title = "My Issued Books";
}

<style>
    .dot {
        height: 10px;
        width: 15px;
        background-color: #bbb;
        border-radius: 50%;
        display: inline-block;
    }

    .dotG {
        height: 10px;
        width: 15px;
        background-color: green;
        border-radius: 50%;
        display: inline-block;
    }

    .m-b-10 {
        margin-bottom: 10px;
    }

    .m-t-10 {
        margin-top: 10px;
    }

    .modal-header {
        background: rgb(240, 188, 180);
    }

    i.fa {
        color: black;
        font-size: 16px;
        margin-right: 5px;
        cursor: pointer;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <span class="pull-left">My Issued Books</span>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="panel-body">
                        @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                        <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblData">
                            <thead>
                                <tr>
                                    <th>Book Name</th>
                                    <th>Author</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section body_scripts{
    <script type="text/javascript">
        var _StudentID = '@ViewBag.StudentID';

        $(document).ready(function () {
            fn_Bindtbl(_StudentID, "SelectStudent");
        });

        function fn_Bindtbl(_Id, Type) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("viewBookIssueMaster", "Library")',
                data: JSON.stringify({ Id: _Id, Type: Type, SearchID: _Id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#tblData tbody').empty();
                    $.each(data, function (rowIndex, val) {
                        var row = '';
                        row += '<tr>';
                        row += '<td>' + val.BookName + '</td>';
                        row += '<td>' + val.BookAuthor + '</td>';
                        row += '<td>' + val.IssueDate + '</td>';
                        row += '<td>' + val.DueDate + '</td>';

                        var _over = parseInt(val.OverdueDays) || 0;
                        if (val.BookStatus == 'Returned') {
                            row += '<td><i class="dotG"></i> ' + val.BookStatus + '</td>';
                        }
                        else if (_over > 0) {
                            row += '<td><i class="dot"></i> <span style="color:red;font-weight:bold;">Overdue (' + _over + ' days)</span></td>';
                        }
                        else {
                            row += '<td><i class="dot"></i> ' + val.BookStatus + '</td>';
                        }
                        row += '</tr>';
                        $('#tblData tbody').append(row);
                    });
                    $('#tblData').dataTable();
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });
        }
    </script>
}