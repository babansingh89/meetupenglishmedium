@{
    ViewBag.Title = "Student Fees Collection List";
    //Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    .card-body-modern .form-group { margin-bottom: 14px; }
    .card-body-modern .control-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    .card-body-modern .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    .card-body-modern .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    .card-body-modern .form-control[disabled] {
        background: #f8fafc;
        color: #94a3b8;
        cursor: not-allowed;
        border-color: #e2e8f0;
    }
    .card-body-modern .input-group .form-control { border-radius: 6px 0 0 6px !important; }
    .card-body-modern .input-group-btn:last-child > .btn { margin-left: 0; }

    .btn-search {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 0 6px 6px 0;
        color: #fff;
        height: 38px;
        width: 42px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .2s;
    }
    .btn-search:hover { background: linear-gradient(135deg, #006d8f, #005477); }

    #tblFeesCollection {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblFeesCollection thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblFeesCollection thead th:last-child { border-right: none !important; }
    #tblFeesCollection tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblFeesCollection tbody tr:nth-child(even) { background: #fafcfe; }
    #tblFeesCollection tbody tr:hover { background: #eef6ff; }
    #tblFeesCollection i.fa {
        color: #64748b;
        margin-right: 10px;
        transition: color .2s;
        cursor: pointer;
    }
    #tblFeesCollection i.fa:hover { color: #0089b3; }
    #tblFeesCollection i.Icondelclass { color: #dc2626 !important; }

    #tblFeesCollection_wrapper .dataTables_length label,
    #tblFeesCollection_wrapper .dataTables_filter label,
    #tblFeesCollection_wrapper .dataTables_info,
    #tblFeesCollection_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblFeesCollection_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblFeesCollection_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblFeesCollection_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblFeesCollection_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblFeesCollection_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblFeesCollection_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-cash-coin"></i></span>
                <span class="header-title">Student Fees Collection</span>
                <a href="@Url.Action("StudentFeesCollection_Bengali", "Transaction")" class="btn btn-register"><i class="bi bi-plus-lg"></i> Add New Record</a>
            </div>
            <div class="card-body-modern">
                <div class="row">
                @*<div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label">Class:</label>
                            @Html.DropDownList("ddlClassList", (IList<SelectListItem>)ViewBag.ClassList, new { @class = "form-control" })
                        </div>
                    </div>*@
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label">Reg No.:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="txtRegNo" autocomplete="off" value="" placeholder="Enter Reg. No." />
                            <span class="input-group-btn">
                                <button class="btn btn-search" id="btnsearch" type="button"><i class="fa fa-search" aria-hidden="true"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Student Name:</label>
                        <input type="text" class="form-control" id="txtStudentName" autocomplete="off" value="" disabled />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label">Class & Section:</label>
                        <input type="text" class="form-control" id="txtclassSec" autocomplete="off" value="" disabled />
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group">
                        <label class="control-label">Gender:</label>
                        <input type="text" class="form-control" id="txtGender" autocomplete="off" value="" disabled />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label">Roll No.:</label>
                        <input type="text" class="form-control" id="txtRollNo" autocomplete="off" value="" disabled />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label">Phone No.:</label>
                        <input type="text" class="form-control" id="txtPhone" autocomplete="off" value="" disabled />
                    </div>
                </div>

                <div class="col-md-9" style="display:none">
                    <div class="form-group">
                        @{
                            // Initialize the list of months statically in the view
                            var months = new List<dynamic>
                                                                                                                                                                                                                                                                                                                                    {
                        new { Id = 1, Name = "Jan" },
                        new { Id = 2, Name = "Feb" },
                        new { Id = 3, Name = "Mar" },
                        new { Id = 4, Name = "Apr" },
                        new { Id = 5, Name = "May" },
                        new { Id = 6, Name = "Jun" },
                        new { Id = 7, Name = "Jul" },
                        new { Id = 8, Name = "Aug" },
                        new { Id = 9, Name = "Sep" },
                        new { Id = 10, Name = "Oct" },
                        new { Id = 11, Name = "Nov" },
                        new { Id = 12, Name = "Dec" }
                    };

                            <div class="horizontal-checkbox-list" style="font-family: fantasy;font-size: 18px;color: darkslategray; padding-top:26px;">
                                <div id="monthlst"></div>
                                @foreach (var month in months)
                                {
                                    <label class="checkbox-inline">
                                        <input type="checkbox" name="months" class="chkMonth" value="@month.Id" /> @month.Name
                                    </label>

                                }

                            </div>
                        }
                    </div>
                </div>

            </div>



            <div class="row" style="margin-top: 4px;">
                <div class="col-lg-12">
                    @Html.Partial("~/Views/Shared/SuccessError.cshtml")

                    <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblFeesCollection">
                        <thead>
                            <tr>
                                <th style="text-align:center">SlNo.</th>
                                <th style="text-align:center">Student Name</th>
                                <th style="text-align:center">Receipt No.</th>
                                <th style="text-align:center">Receipt Date</th>
                                <th style="text-align:center">Admission Amount</th>
                                <th style="text-align:center">Other Amt</th>
                                <th style="text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdId" value="0" />

@section body_scripts{


    <script type="text/javascript">
        $(document).ready(function () {
            fn_Bindtbl("0", "Select");

        });

        $(document).ready(function () {
                $('#txtRegNo').autocomplete({
                    source: function (request, response) {

                        $.ajax({
                            url: '@Url.Action("Auto_RegNo", "Transaction")',
                            data: { SR_No: $("#txtRegNo").val() },
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            cache: false,
                            success: function (serverResponse) {
                                var AutoComplete = [];
                                console.log(serverResponse[0]);

                                if ((serverResponse[0]).length > 0) {

                                    $.each(serverResponse[0], function (index, item) {
                                        AutoComplete.push({
                                            label: item.SR_RegNo,
                                            SR_ID: item.SR_ID
                                        });
                                    });

                                    response(AutoComplete);
                                }
                            }
                        });
                    },
                    select: function (e, i) {
                        //$('#hdId').val(i.item.SR_ID);

                    },
                    minLength: 1
                }).click(function () {
                    $(this).autocomplete('search', ($(this).val()));
                });
            });

        $(document).on("click", ".Icondelclass", function () {
            if (confirm("Are you sure want to delete?")) {
                var _Id = $(this).attr('data-ID');
                fn_del(_Id);
            }
        });

        $(document).on('click', '#btnsearch', function () {

var _RegNo = $('#txtRegNo').val();
if (_RegNo == '') {
    FormSuccessError1("Please enter Reg No.", "Error", "errorBlock", "div_Scroll");
    $('#txtRegNo').focus();
    return false;
}

$.ajax({
    type: "POST",
    url: '@Url.Action("ViewFeecollection", "Transaction")',
    data: JSON.stringify({ RegNo: _RegNo, Type: "FeeList_Bengali"}),
    contentType: "application/json; charset=utf-8",
    dataType: "json",
    cache: false,
    success: function (data) {

        console.log(data);
        if (data.length > 0) {
            $('#tblFeesCollection tbody').empty();
            var cnt = 0;

            $('#txtStudentName').val(data[0]["SR_StudentName"]);
            $('#txtclassSec').val(data[0]["ClassName"] + " & " + data[0]["SectionName"]);
            $('#txtGender').val(data[0]["SR_Gender"]);
            $('#txtRollNo').val(data[0]["SR_CurrentRollNo"]);
            $('#txtPhone').val(data[0]["SR_PhNo"]);

            $.each(data, function (rowIndex, val) {
                cnt++;
                var row = '';
                row += '<tr id=' + val.SR_ID + '>';
                row += '<td style="vertical-align: middle; width:30px; text-align:center; ">' + cnt + '</td>';
                row += '<td style="vertical-align: middle; text-align:center; ">' + val.SR_StudentName + '</td>';
                row += '<td style="vertical-align: middle; text-align:center; ">' + val.SFC_ReceiptNo + '</td>';
                row += '<td style="vertical-align: middle; text-align:center;  ">' + val.SFC_Date + '</td>';
                row += '<td style="vertical-align: middle; text-align:right;  ">' + val.SFC_PaymentAmount + '</td>';
                row += '<td style="vertical-align: middle; text-align:right;  ">' + val.SFC_PaymentAmountOther + '</td>';
                row += '<td style="vertical-align: middle; text-align:center; "><i class="fa fa-print Iconprint" data-RegNo="' + val.SR_RegNo + '" data-MonthID="' + val.PayMonthID + '"></i></td>';
                row += '</tr>';
                $('#tblFeesCollection tbody').append(row);
            });

            //alert(data[0][0].SR_ID);
            //$("#hdId").val(data[0][0].SR_ID);

        } else {
            $('#tblFeesCollection tbody').empty();
            FormSuccessError1("No any Fee payment record found.", "Error", "errorBlock", "div_Scroll");
            $('#txtRegNo').focus();
            return false;
        }
    },
    error: function (error) {
        console.error(error);
        //FormSuccessError(error, "Error", "errorBlock");
        return false;
    }
});


});

        function fn_Bindtbl(_Id, Type) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("viewFeecollection", "Transaction")',
                data: JSON.stringify({ Id: _Id, Type: Type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (Type == "Select") {
                        $('#tblFeesCollection tbody').empty();
                        $.each(data, function (rowIndex, val) {
                            var row = '';
                            row += '<tr>';
                            row += '<td>' + val.SFC_ReceiptNo + '</td>';
                            row += '<td>' + val.SFC_Date + '</td>';
                            row += '<td>' + val.SR_StudentName + '</td>';
                            row += '<td>' + val.ClassName + '</td>';
                            row += '<td>' + val.SFC_PaymentAmount + '</td>';
                            row += '<td><i class="fa fa-print Iconprint" data-ID="' + val.SFC_Id + '"></i><i class="fa fa-trash-o Icondelclass" data-ID="' + val.SFC_Id + '"></i></td>';
                            row += '</tr>';
                            $('#tblFeesCollection tbody').append(row);

                        });
                        $('#tblFeesCollection').dataTable();
                    }


                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        }

        function fn_del(Id) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("deleteCollectionFees", "Transaction")',
                data: JSON.stringify({ Id: Id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "deleteSuccessful") {
                        fn_Bindtbl("0", "Select");
                        FormSuccessError("Data deleted successfully.", "Success", "errorBlock");
                        //alert("Class deleted successfully.");
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        };
        $(document).on('click', '.Iconprint', function (e) {
            e.preventDefault();
            var _RegNo = $(this).attr('data-RegNo');
            //var _PayMonth = $(this).attr('data-MonthID');
            Print(_RegNo);
        });
        function Print(_RegNo) {

            var final = {}; var master = []; var detail = [];

            master.push({
                ReportName: "FeeCollection_Bengali.rpt",
                FileName: "FeeCollection",
                AppID: ""
            });

            detail.push({
                Class: "", //$('#ddlClassList').val(),
                Section: "", // $('#ddlSectionList').val(),
                RegNo: _RegNo,
                PayMonth: "", //selectedMonths.join(','),
                //AppID: "" // 18
            });

            final = {
                Master: master,
                Detail: detail
            }

            var left = ($(window).width() / 2) - (950 / 2),
                top = ($(window).height() / 2) - (650 / 2),
                popup = window.open("/OpenReport/OpenReports.aspx?ReportName=" + JSON.stringify(final), "popup", "width=950, height=650, top=" + top + ", left=" + left);
            popup.focus();
        }
        function GeneratePrintPDF(StdId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("FeePrintPDF", "Transaction")',
                data: JSON.stringify({ StdId: StdId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (data == "Error") {
                        alert("Error! Try again later.");
                    }
                    else {
                        window.open(data);
                        //previewPdfDocument(data);
                    }
                },
                error: function (error) {
                    console.log(error);
                    //alert("Error! Try again later.");
                    window.location.href = "/Error";
                }
            });
        }

    </script>
}


