@{
    ViewBag.Title = "StudentFeesCollection_Automapper";
    //Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}


<input type="hidden" id="hdId" value="0" />
<input type="hidden" id="hdPrintId" value="0" />
<input type="hidden" id="hdnReceiptId" value="0" />

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-wallet2"></i></span>
                <span class="header-title">Student Fee Collection</span>
                <span class="header-badge">Auto Mapper</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")

                <div class="row" style="display:none;">
                    <div class="col-md-2">
                        <div class="form-group">
                            <input type="radio" name="RadioFees" id="Radio1" class="custom-radio" value="1">Admission
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <input type="radio" name="RadioFees" id="Radio2" class="custom-radio" value="2">Collection
                        </div>
                    </div>
                </div>

                <div class="student-search-section">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">Registration No.<span class="required-star">*</span></label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="txtRegNo" autocomplete="off" value="@ViewBag.RegNo" placeholder="Enter Reg. No." />
                                    <span class="input-group-btn">
                                        <button class="btn btn-search" id="btnsearch" type="button"><i class="fa fa-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">Student Name</label>
                                <input type="text" class="form-control" id="txtName" autocomplete="off" disabled />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Class Name</label>
                                <input type="text" class="form-control" id="txtclassName" autocomplete="off" disabled />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Section Name</label>
                                <input type="text" class="form-control" id="txtSectionName" autocomplete="off" disabled />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Roll No.</label>
                                <input type="text" class="form-control" id="txtrollno" autocomplete="off" disabled />
                            </div>
                        </div>
                    </div>
                </div>

                @{
                    var months = new List<dynamic>
                    {
                        new { Id = 1, Name = "January" },
                        new { Id = 2, Name = "February" },
                        new { Id = 3, Name = "March" },
                        new { Id = 4, Name = "April" },
                        new { Id = 5, Name = "May" },
                        new { Id = 6, Name = "June" },
                        new { Id = 7, Name = "July" },
                        new { Id = 8, Name = "August" },
                        new { Id = 9, Name = "September" },
                        new { Id = 10, Name = "October" },
                        new { Id = 11, Name = "November" },
                        new { Id = 12, Name = "December" }
                    };
                }

                <div class="month-selector">
                    @*<label class="section-label">Select Month</label>*@
                    <div id="monthlst" class="month-checkbox-list"></div>
                </div>

                <div class="col-md-12" style="display:none;">
                    <div class="form-group text-center">
                        <button class="btn btn-primary" id="btnGenerateFee">Generate Fee</button>
                    </div>
                </div>

                <div class="fee-table-section">
                    <table class="table" id="tblfee">
                        <thead>
                            <tr>
                                <th class="col-sl">SlNo(#)</th>
                                <th class="col-particulars">Fee Particulars</th>
                                <th class="col-amount">Fee Amount (&#x20b9;)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="total-label">Total Month Fee (A)</td>
                                <td class="total-value" style="padding-right:13px !important;" id="totalAmount">0.00</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="payment-section">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Pay mode:</label> <span class="required-star">*</span>
                                <select class="form-control" id="ddlPayMode">
                                    <option value="0">Select</option>
                                    <option value="C" selected>Cash</option>
                                    <option value="D">Draft</option>
                                    <option value="Q">Cheque</option>
                                    <option value="O">Online</option>
                                    <option value="N">Neft</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Transaction No.:</label>
                                <input type="text" class="form-control" id="txtTransactionno" autocomplete="off" disabled value="" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Transaction Date:</label>
                                <input type="text" class="form-control dateFormat" id="txtTransactiondate" autocomplete="off" disabled value="" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">Remarks:</label>
                                <input type="text" class="form-control" id="txtRemarks" autocomplete="off" value="" placeholder="Optional remarks" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-bar">
                    <button class="btn btn-submit-print" id="btnSubmitPrint">
                        <i class="bi bi-save"></i> Submit & Print
                    </button>
                    <button class="btn btn-cancel" id="btncancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="conModel" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-confirm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="exampleModalLabel">Payment Confirmation</h4>
            </div>
            <div class="modal-body">
                <div class="confirmation-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <p class="confirmation-text">Your Payment collection has been done.</p>
                <p class="clsReceiptno confirmation-receipt"></p>
                <p class="confirmation-thanks">Thank you!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-print clsconfPrint">
                    <i class="bi bi-printer"></i> Print
                </button>
                <button type="button" class="btn btn-close-modal clsconfClose" data-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }

    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    /* ===== Base Card ===== */
