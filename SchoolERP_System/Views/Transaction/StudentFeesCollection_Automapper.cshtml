        function updateGrossTotal() {
        var netAmt = $('#txtNetAmount').val() == "" ? 0.00 : parseFloat($('#txtNetAmount').val());
        var letAmt = $('#txtLateFee').val() == "" ? 0.00 : parseFloat($('#txtLateFee').val());
