
@{
    ViewBag.Title = "Exam Schedule";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}



<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    #tblData {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblData thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblData thead th:last-child { border-right: none !important; }
    #tblData tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblData tbody tr:nth-child(even) { background: #fafcfe; }
    #tblData tbody tr:hover { background: #eef6ff; }

    #tblData_wrapper .dataTables_length label,
    #tblData_wrapper .dataTables_filter label,
    #tblData_wrapper .dataTables_info,
    #tblData_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblData_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblData_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblData_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblData_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblData_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblData_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }
</style>
<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-calendar2-check"></i></span>
                <span class="header-title">View Exam Schedule</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Exam:<span style="color:red;">*</span></label>
                        @Html.DropDownList("ddlExamList", (IList<SelectListItem>)ViewBag.ExamList, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Class:<span style="color:red;">*</span></label>
                        <select id="ddlClassList" class="form-control"> </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <button type="button" class="btn btn-primary" style="margin-top: 20px;" id="btnSearch">Filter</button>
                        <button type="button" class="btn btn-primary" style="margin-top: -33px;margin-left:75px;width: 125px;background-color: cadetblue;display:none;" id="btnPrint">Print</button>
                    </div>
                </div>

                <div id="stlist" class="row">
                    <div class="col-lg-12">
                        <div id="dvtbl">
                            <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblData">
                                <thead>
                                    <tr>
                                        <th>Exam Name</th>
                                        <th>Class</th>
                                        <th>Subject</th>
                                        <th>Date</th>
                                        <th>Timings</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section body_scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $('#dvtbl').hide();
            $("#ddlExamList").select2({
                placeholder: "Select"
            });
            $("#ddlClassList").select2({
                placeholder: "Select"
            });
           
        });
        $("#ddlExamList").change(function () {

            var ID = $('option:selected', this).val();
            if (ID == '' || ID <= 0) {
                return false;
            }
            $.ajax({
                type: "POST",
                url: '/Exam/viewExamTimetableMaster',
                data: JSON.stringify({ ExamID: ID, Type: "BindClass" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (data) {
                    $("#ddlClassList").empty().append('<option selected="selected" value="0">Select</option>');
                    if (data.length > 0) {
                        $.each(data, function () {
                            $("#ddlClassList").append($("<option/>").val(this.ClassID).text(this.ClassName));
                        });
                    }
                }
            });
        });
        $(document).on("click", "#btnSearch", function () {
            var _ddl2 = $('#ddlClassList').val();
            var _ddl1 = $('#ddlExamList').val();

            if (_ddl1 == '' || _ddl1 <= 0) {
                FormSuccessError1("Please Select Exam.", "Error", "errorBlock", "div_Scroll");
                return false;
            }
            if (_ddl2 == '' || _ddl2 <= 0) {
                FormSuccessError1("Please Select Class.", "Error", "errorBlock", "div_Scroll");
                return false;
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("viewExamTimetableMaster", "Exam")',
                data: JSON.stringify({ ExamID: _ddl1, ClassID: _ddl2, Type: "Select" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {

                    $('#tblData tbody').empty();
                    $.each(data, function (rowIndex, val) {
                        var row = '';
                        row += '<tr>';
                        row += '<td>' + val.ExamName + '</td>';
                        row += '<td>' + val.ClassName + '</td>';
                        row += '<td>' + val.SubjectName + '<br> <small style="font-size: 10px; color: black;">Day : ' + val.ExamDay + '</small></td>';
                        row += '<td>' + val.ExamDate + '</td>';
                        row += '<td>' + val.StHr + ' - ' + val.EnHr + '</td>';
                       row += '</tr>';
                        $('#tblData tbody').append(row);
                        $('#dvtbl').show();
                    });
                    $('#tblData').dataTable({
                        dom: 'Bfrtip',
                        buttons: [
                       'csv', 'excel', 'pdf'
                        ]
                    });

                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        });
    </script>
}

