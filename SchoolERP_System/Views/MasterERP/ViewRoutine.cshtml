
@{
    ViewBag.Title = "View Routine";
}
<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    #tblMapping {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblMapping thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping thead th:last-child { border-right: none !important; }
    #tblMapping tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblMapping tbody tr:nth-child(even) { background: #fafcfe; }
    #tblMapping tbody tr:hover { background: #eef6ff; }

    #tblMapping_wrapper .dataTables_length label,
    #tblMapping_wrapper .dataTables_filter label,
    #tblMapping_wrapper .dataTables_info,
    #tblMapping_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblMapping_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblMapping_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblMapping_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblMapping_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }
</style>
<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-calendar3-week"></i></span>
                <span class="header-title">View Routine</span>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <div id="stlist" class="row">
                    <div class="col-lg-12">
                        <div ID="dvContents">
                            <table id="tblMapping" class="table table-striped table-bordered table-centered mb-0">
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section body_scripts{
    <script type="text/javascript">

        $(document).ready(function () {
            $('#tblMapping tbody').empty();
            fn_Bindtbl("SelectByTeacher");
        });

        function fn_Bindtbl(_type) {

            $.ajax({
                type: "POST",
                url: '@Url.Action("viewRoutineForTeacher", "MasterERP")',
                data: JSON.stringify({ Type: _type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    $('#tblMapping tbody').empty();
                    var row = '';
                    //Monday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Monday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Monday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';

                        }
                    });
                    row += '</td></tr>';

                    //Tuesday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Tuesday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Tuesday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';
                        }
                    });
                    row += '</td></tr>';

                    //Wednesday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Wednesday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Wednesday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';
                        }
                    });
                    row += '</td></tr>';

                    //Thursday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Thursday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Thursday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';
                        }
                    });
                    row += '</td></tr>';

                    //Friday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Friday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Friday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';
                        }
                    });
                    row += '</td></tr>';

                    //Saturday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Saturday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Saturday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';
                        }
                    });
                    row += '</td></tr>';

                    //Sunday
                    row += '<tr><td style="font-weight: bold; width : 100px;">Sunday</td><td class="m-1">';
                    $.each(data, function (rowIndex, val) {
                        if (val.Days == 'Sunday') {
                            row += '<div class="btn-group text-left"><button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-expanded="false">';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-book" style="color:white;"></i>' + val.SubjectName + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-clock-o" style="color:white;"></i>' + val.StHr + ' - ' + val.EnHr + '</p>';
                            row += '<p style="margin-bottom: 0px;"><i class="fa fa-gavel" style="color:white;"></i>' + val.EM_EmpName + '</p></div>';
                        }
                    });
                    row += '</td></tr>';
                    $('#tblMapping tbody').append(row);
                    // $("#btnPrint").css("display", "block");
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });

        }



    </script>
}