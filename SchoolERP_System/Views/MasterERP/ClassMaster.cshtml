@{
    ViewBag.Title = "ClassMaster";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<style>
    .wrapper { padding: 0 !important; margin-top: 64px !important; }
    #div_Scroll { margin: 0 !important; }
    #div_Scroll .col-lg-12 { padding: 0 !important; }

    .card-modern {
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        border: none;
        overflow: hidden;
    }
    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 2px solid #0089b3;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-modern .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 8px;
        color: #fff;
        font-size: 18px;
        flex-shrink: 0;
    }
    .card-header-modern .header-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.2px;
    }
    .card-header-modern .btn-register {
        margin-left: auto;
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        box-shadow: 0 2px 8px rgba(0,137,179,.2);
    }
    .card-header-modern .btn-register:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,137,179,.3);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .card-body-modern {
        padding: 16px 20px 24px;
        font-family: 'Roboto', sans-serif;
    }

    #tblclass {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
        border: 1px solid #e2e8f0;
    }
    #tblclass thead th {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 18px !important;
        border: none !important;
        border-right: 1px solid rgba(255,255,255,.08) !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblclass thead th:last-child { border-right: none !important; }
    #tblclass tbody td {
        padding: 10px 18px !important;
        font-size: 13px;
        color: #1e293b;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: none !important;
        vertical-align: middle !important;
        white-space: nowrap;
    }
    #tblclass tbody tr:nth-child(even) { background: #fafcfe; }
    #tblclass tbody tr:hover { background: #eef6ff; }
    #tblclass i.fa {
        color: #64748b;
        margin-right: 10px;
        transition: color .2s;
        cursor: pointer;
    }
    #tblclass i.fa:hover { color: #0089b3; }
    #tblclass i.Icondelclass { color: #dc2626 !important; }

    #tblclass_wrapper .dataTables_length label,
    #tblclass_wrapper .dataTables_filter label,
    #tblclass_wrapper .dataTables_info,
    #tblclass_wrapper .dataTables_paginate {
        font-size: 13px;
        color: #475569;
    }
    #tblclass_wrapper .dataTables_filter input {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 6px 10px;
        height: 34px;
        outline: none;
    }
    #tblclass_wrapper .dataTables_filter input:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #tblclass_wrapper .dataTables_length select {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 5px;
        height: 34px;
    }
    #tblclass_wrapper .dataTables_paginate .paginate_button {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        margin: 0 2px;
        color: #475569 !important;
        background: #fff !important;
    }
    #tblclass_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #0089b3, #006d8f) !important;
        color: #fff !important;
        border-color: #0089b3 !important;
    }
    #tblclass_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #0089b3 !important;
    }

    #classeModal .modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 25px 60px rgba(0,0,0,.15);
    }
    #classeModal .modal-header {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border-radius: 12px 12px 0 0;
        padding: 16px 24px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    #classeModal .modal-title {
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: .2px;
    }
    #classeModal .modal-header .close {
        color: rgba(255,255,255,.6);
        opacity: 1;
        text-shadow: none;
        font-size: 22px;
    }
    #classeModal .modal-header .close:hover { color: #fff; opacity: 1; }
    #classeModal .modal-body {
        padding: 24px;
        font-family: 'Roboto', sans-serif;
    }
    #classeModal .form-group { margin-bottom: 14px; }
    #classeModal .form-group label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }
    #classeModal .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        box-shadow: none;
        font-size: 13px;
        padding: 8px 12px;
        height: 38px;
        transition: border-color .2s, box-shadow .2s;
        color: #0f172a;
    }
    #classeModal .form-control:focus {
        border-color: #0089b3;
        box-shadow: 0 0 0 3px rgba(0,137,179,.1);
    }
    #classeModal .modal-footer {
        padding: 14px 24px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    #classeModal .modal-footer .btn {
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        padding: 9px 20px;
        transition: all .2s;
    }
    #classeModal .modal-footer .btn-primary {
        background: linear-gradient(135deg, #0089b3, #006d8f);
        border: none;
        color: #fff;
    }
    #classeModal .modal-footer .btn-primary:hover {
        background: linear-gradient(135deg, #006d8f, #004d66);
    }
    #classeModal .modal-footer .btn-default {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        color: #475569;
    }
    #classeModal .modal-footer .btn-default:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
    }
</style>

<div class="row" id="div_Scroll">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="header-icon"><i class="bi bi-mortarboard"></i></span>
                <span class="header-title">View Class</span>
                <button class="btn btn-register openModal"><i class="bi bi-plus-lg"></i> Add Class</button>
            </div>
            <div class="card-body-modern">
                @Html.Partial("~/Views/Shared/SuccessError.cshtml")
                <table class="table table-striped table-bordered table-hover table-condensed dt-responsive" id="tblclass">
                    <thead>
                        <tr>
                            <th>Class Name</th>
                            <th>Class Strength</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hdnclassId" value="0" />
<div class="modal fade" id="classeModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="exampleModalLabel">Add/Update Class</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @Html.Partial("~/Views/Shared/Modal_SuccessError.cshtml")
                <div class="form-group">
                    <label for="recipient-name" class="control-label">Class Name:<span style="color:red;">*</span></label>
                    <input type="text" class="form-control" id="txtclassName">
                </div>
                <div class="form-group">
                    <label for="recipient-name" class="control-label">Class Strength:<span style="color:red;">*</span></label>
                    <input type="text" class="form-control Numeric" id="txtClassStrength" maxlength="100">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

@section body_scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            fn_Bindclasstbl("0", "Select");
        });

        $(document).on("click", ".openModal", function () {
            HideSuccErrDiv();
            ModalHideSuccErrDiv();
            fn_resetform();
            $("#classeModal").modal();
        });

        $(document).on("click", ".Iconeditclass", function () {
            var _ClassId = $(this).attr('data-ClassID');
            $("#hdnclassId").val(_ClassId);
            fn_Bindclasstbl(_ClassId, "SelectByID");
        });

        $(document).on("click", ".Icondelclass", function () {
            if (confirm("Are you sure want to delete?")) {
                var _ClassId = $(this).attr('data-ClassID');
                fn_delClass(_ClassId);
            }
        });

        $(document).on("click", "#btnSave", function () {
            ModalHideSuccErrDiv();
            var _ClassId = $.trim($("#hdnclassId").val());
            var _className = $.trim($("#txtclassName").val());
            var _ClassStrength = $.trim($("#txtClassStrength").val());
            if (_className == "") {
                ModalPopupError("Please enter class name.", "Error", "M_errorBlock");
                return false;
            }
            if (_ClassStrength == "") {
                ModalPopupError("Please enter class ctrength.", "Error", "M_errorBlock");
                return false;
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("saveClassMaster", "MasterERP")',
                data: JSON.stringify({ ClassId: _ClassId, className: _className, ClassStrength: _ClassStrength }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "InsertSuccessful") {
                        fn_resetform();
                        ModalPopupError("Class Inserted successfully.", "Success", "M_errorBlock");
                        fn_Bindclasstbl("0", "Select");
                    }
                    else if (response == "UpdateSuccessful") {
                        fn_resetform();
                        ModalPopupError("Class updated successfully.", "Success", "M_errorBlock");
                        fn_Bindclasstbl("0", "Select");
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        });

        function fn_Bindclasstbl(_ClassId, Type) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("viewClassMaster", "MasterERP")',
                data: JSON.stringify({ ClassId: _ClassId, Type: Type }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (data) {
                    if (Type == "Select") {
                        $('#tblclass tbody').empty();
                        $.each(data, function (rowIndex, val) {
                            var row = '';
                            row += '<tr>';
                            row += '<td>' + val.ClassName + '</td>';
                            row += '<td>' + val.ClassStrength + '</td>';
                            row += '<td><i class="fa fa-edit Iconeditclass" data-ClassID="' + val.ClassID + '"></i><i class="fa fa-trash-o Icondelclass" data-ClassID="' + val.ClassID + '"></i></td>';
                            row += '</tr>';
                            $('#tblclass tbody').append(row);
                        });
                        $('#tblclass').dataTable();
                    }

                    if (Type == "SelectByID") {
                        $('#btnSave').text("Update");
                        $("#txtclassName").val(data[0].ClassName);
                        $("#txtClassStrength").val(data[0].ClassStrength);
                        $("#classeModal").modal();
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        }

        function fn_delClass(ClassId) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("deleteClassMaster", "MasterERP")',
                data: JSON.stringify({ ClassId: ClassId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (response == "deleteSuccessful") {
                        fn_Bindclasstbl("0", "Select");
                        FormSuccessError("Class deleted successfully.","Success", "errorBlock");
                        //alert("Class deleted successfully.");
                    }
                    else {
                        alert("Error. Try again latet.");
                        return false;
                    }
                },
                error: function (error) {
                    console.error(error);
                    //FormSuccessError(error, "Error", "errorBlock");
                    return false;
                }
            });
        };

        function fn_resetform() {
            $("#hdnclassId").val('0');
            $("#txtclassName").val('');
            $("#txtClassStrength").val('');
            $('#btnSave').text("Save");
        }
    </script>
}